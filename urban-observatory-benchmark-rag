","\n","_KBENCH_AVAILABLE = False\n","_KBENCH_LLMS: dict = {}\n","_KBENCH_COOLDOWN: dict = {}\n","_KBENCH_DEFAULT_COOLDOWN = 600.0\n","_KBENCH_QUOTA_COOLDOWN = 24 * 3600.0\n","\n","class KBenchModelCooled(ModelCooled):\n","    \"\"\"Kaggle-AI model is unusable for some period (quota, error, missing).\"\"\"\n","    pass\n","\n","def _kbench_cool(model_short: str, dur: float, reason: str = \"\"):\n","    _KBENCH_COOLDOWN[model_short] = time.time() + dur\n","    print(f\"  ✗ kbench cooldown ({model_short}) ~{dur:.0f}s — {reason[:120]}\")\n","\n","def _try_kbench(messages, model_short: str, max_tokens: int, temperature: float):\n","    \"\"\"Adapter from chat-completion shape to kaggle_benchmarks llm.prompt().\"\"\"\n","    if not _KBENCH_AVAILABLE:\n","        raise KBenchModelCooled(\n","            f\"kbench/{model_short}\", time.time() + _KBENCH_QUOTA_COOLDOWN,\n","            \"kaggle_benchmarks unavailable\")\n","    if model_short in _KBENCH_COOLDOWN and _KBENCH_COOLDOWN[model_short] > time.time():\n","        raise KBenchModelCooled(\n","            f\"kbench/{model_short}\", _KBENCH_COOLDOWN[model_short], \"still cooled\")\n","    llm_obj = _KBENCH_LLMS.get(model_short)\n","    if llm_obj is None:\n","        _kbench_cool(model_short, _KBENCH_QUOTA_COOLDOWN, \"model not in kbench.llms\")\n","        raise KBenchModelCooled(\n","            f\"kbench/{model_short}\", _KBENCH_COOLDOWN[model_short], \"missing\")\n","    prompt_text = \"\\n\\n\".join(\n","        m.get(\"content\", \"\") for m in messages if m.get(\"content\"))\n","    try:\n","        out = llm_obj.prompt(prompt_text)\n","        if hasattr(out, \"text\"):\n","            out = out.text\n","        return str(out)\n","    except Exception as exc:\n","        msg = str(exc).lower()\n","        if any(s in msg for s in (\"quota\", \"exceeded\", \"limit\", \"429\", \"billing\", \"permission\")):\n","            _kbench_cool(model_short, _KBENCH_QUOTA_COOLDOWN, f\"quota/permission: {exc}\")\n","      