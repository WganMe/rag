n_major":2,"version_minor":0},"text/plain":["vocab.txt:   0%|          | 0.00/232k [00:00<?, ?B/s]"]},"metadata":{},"output_type":"display_data"},{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"78482282cf9348de8ec49277dfe52b99","version_major":2,"version_minor":0},"text/plain":["tokenizer.json:   0%|          | 0.00/466k [00:00<?, ?B/s]"]},"metadata":{},"output_type":"display_data"},{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"d648a05fe72342ed861bf131462d078a","version_major":2,"version_minor":0},"text/plain":["special_tokens_map.json:   0%|          | 0.00/112 [00:00<?, ?B/s]"]},"metadata":{},"output_type":"display_data"},{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"6603830acdab426889e3b104a2500ea6","version_major":2,"version_minor":0},"text/plain":["config.json:   0%|          | 0.00/190 [00:00<?, ?B/s]"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["Embedding model ready: all-MiniLM-L6-v2\n","Embedded 3 schema chunks with all-MiniLM-L6-v2 (dim 384)\n","\n","Retrieval tests:\n","  Q: List all sensor names\n","    Naive:    ['sensors', 'readings']\n","    Enhanced: ['readings', 'sensors']\n","  Q: What is the average NO2 per sensor?\n","    Naive:    ['readings', 'sensors']\n","    Enhanced: ['readings', 'sensors']\n","  Q: Compare NO2 and PM2.5 across brokers\n","    Naive:    ['variables', 'readings']\n","    Enhanced: ['readings', 'variables', 'sensors']\n","\n","RAG pipeline ready. Strategies: naive, enhanced\n"]}],"source":["# pyright: reportUnknownMemberType=false, reportUnknownVariableType=false, reportUnknownArgumentType=false, reportMissingTypeStubs=false, reportUnknownParameterType=false, reportAttributeAccessIssue=false, reportCallIssue=false, reportOperatorIssue=false, reportConstantRedefinition=false, reportPossiblyUnboundVariable=false, reportUnusedFunction=false\n","# ════════════════════════════════════════════════════════════════════════════\n","# RAG RETRIEVAL STACK — embedding model + schema vector store\n","# ════════════════════════════════════════════════════════════════════════════\n","# IMPORTANT — why this cell must never be fatal.\n","# The RAG benchmark needs an embedding model; the FIGURES section does not (it\n","# reads stored result CSVs). An unhandled failure here therefore costs far more\n","# than the RAG arm: it aborts the whole notebook before any figure is produced.\n","# Every step below is consequently guarded, and a failure is reported, not raised.\n","#\n","# protobuf window is >=5.29.6,<6.0 — the same one the kbench cell uses:\n","#   >=5.29.6  the runtime must not be older than the generated code\n","#   <6.0      kaggle-benchmarks' own upper bound\n","# A bare '<6.0' would permit a downgrade below 5.29.6 and break kbench. Never\n","# pin an exact patch: an exact pin (e.g. \"protobuf==5.29.6\") while a different\n","# patch is already loaded raises\n","#   VersionError: gencode 5.29.6  runtime 5.29.5\n","# because pip replaces the generated files underneath the live runtime.\n","%pip install sentence-transformers \"protobuf>=5.29.6,<6.0\" --quiet\n","\n","import os\n","import importlib.metadata as _im\n","\n","\n","def _pb_report() -> dict:\n","    \"\"\"Report protobuf as the RUNTIME sees it, not as pip recorded it.\n","\n","    `importlib.metadata.version()` reads the distribution metadata on disk, which\n","    is exactly the value that lied when this went wrong: a `--force-reinstall`\n","    replaced the generated `*_pb2.py` files while the already-imported runtime C\n","    extension stayed bound, so the disk said 5.29.6 while the live runtime was\n","    5.29.5. Importing `google.protobuf` and touching a generated module is the\n","    only way to see the truth.\n","    \"\"\"\n","    out = {\"disk\": \"unknown\", \"runtime\": \"unknown\", \"generated_ok\": False}\n","    try:\n","        out[\"disk\"] = _im.version(\"protobuf\")\n","    except Exception:\n","        pass\n","    try:\n","        import google.protobuf as _gp\n","        out[\"runtime\"] = getattr(_gp, \"__version__\", \"unknown\")\n","    except Exception as _e:\n","        out[\"runtime\"] = f\"import failed: {type(_e).__name__}\"\n","    try:\n","        from google.protobuf import wrappers_pb2  # noqa: F401\n","        out[\"generated_ok\"] = True\n","    except Exception as _e:\n","        out[\"runtime_error\"] = f\"{type(_e).__name__}: {str(_e)[:120]}\"\n","    return out\n","\n","\n","_PB = _pb_report()\n","print(f\"protobuf: runtime {_PB['runtime']} / disk {_PB['disk']}  \"\n","      f\"(kaggle-benchmarks requires >=5.29.6,<6.0)\")\n","if not _PB[\"generated_ok\"]:\n","    print(f\"  \\u26a0 generated protobuf modules do not load: {_PB.get('runtime_error', '')}\")\n","    print(\"     If disk and runtime disagree above, the runtime is stale and a\")\n","    print(\"     kernel restart is required \\u2014 reinstalling will not help.\")\n","elif _PB[\"disk\"] != _PB[\"runtime\"]:\n","    print(f\"  \\u26a0 disk ({_PB['disk']}) differs from runtime ({_PB['runtime']}).\")\n","    print(\"     The runtime is stale; restart the kernel before relying on it.\")\n","\n","# HF_TOKEN may already be set by the Kaggle Secrets loader; Colab's userdata is\n","# only consulted when actually on Colab (Kaggle ships google.colab too).\n","if not os.environ.get(\"HF_TOKEN\") and globals().get(\"_IN_COLAB\"):\n","    try:\n","        from google.colab import userdata  # type: ignore[import-not-found]\n","        _hf = userdata.get(\"HF_TOKEN\")\n","        if _hf:\n","            os.environ[\"HF_TOKEN\"] = _hf\n","            print(\"HF_TOKEN loaded from Colab secrets\")\n","    except Exception:\n","        pass\n","if not os.environ.get(\"HF_TOKEN\"):\n","    try:\n","        from dotenv import load_dotenv  # type: ignore[import-not-found]\n","        load_dotenv(override=False)\n","    except ImportError:\n","        pass\n","print(f\"HF_TOKEN: {'set' if os.environ.get('HF_TOKEN') else 'not set (public models still work)'}\")\n","\n","import numpy as np\n","\n","# ── Import the embedding stack, but never let it abort the notebook ─────────\n","RAG_EMBED_READY = False\n","embed_model = None\n","EMBED_MODEL_NAME = \"all-MiniLM-L6-v2\"\n","try:\n","    from sentence_transformers import SentenceTransformer\n","    embed_model = SentenceTransformer(EMBED_MODEL_NAME)\n","    RAG_EMBED_READY = True\n","    print(f\"Embedding model ready: {EMBED_MODEL_NAME}\")\n","except Exception as _st_err:\n","    _kind = type(_st_err).__name__\n","    print(f\"\\u26a0 sentence-transformers unavailable ({_kind}): {str(_st_err)[:180]}\")\n","    if \"gencode\" in str(_st_err) or _kind == \"VersionError\":\n","        print(\"  protobuf gencode/runtime skew. The generated .py files were replaced\")\n","        print(\"  under an already-loaded runtime, which a kernel restart is required to\")\n","        print(\"  clear. Restart the kernel and re-run this cell \\u2014 the range-based\")\n","        print(\"  constraint above will not recreate the skew.\")\n","    print(\"  Impact: the RAG benchmark cannot re-run. The FIGURES section is\")\n","    print(\"  unaffected \\u2014 it builds from the stored result CSVs with no embeddings.\")\n","\n","# ── Schema vector store ─────────────────────────────────────────────────────\n","chunk_keys: list[str] = []\n","chunk_texts: list[str] = []\n","chunk_embeddings = None\n","if RAG_EMBED_READY:\n","    chunk_keys = list(SCHEMA_CHUNKS.keys())\n","    chunk_texts = list(SCHEMA_CHUNKS.values())\n","    chunk_embeddings = embed_model.encode(chunk_texts, normalize_embeddings=True)\n","    print(f\"Embedded {len(chunk_keys)} schema chunks with {EMBED_MODEL_NAME} \"\n","          f\"(dim {chunk_embeddings.shape[1]})\")\n","\n","\n","def _require_embeddings() -> None:\n","    if not RAG_EMBED_READY:\n","        raise RuntimeError(\n","            \"RAG embeddings are unavailable in this session, so retrieve_* cannot run.\\n\"\n","            \"Fix the import error printed by the setup cell (usually a protobuf\\n\"\n","            \"gencode/runtime skew, which needs a kernel restart), then re-run it.\"\n","        )\n","\n","\n","# ── Retrieval functions ─────────────────────────────────────────────────────\n","def retrieve_naive(question: str, top_k: int = 2) -> list[str]:\n","    \"\"\"Naive RAG: retrieve top-k schema chunks by cosine similarity.\"\"\"\n","    _require_embeddings()\n","    q_emb = embed_model.encode([question], normalize_embeddings=True)\n","    scores = np.dot(chunk_embeddings, q_emb.T).flatten()\n","    top_indices = np.argsort(scores)[::-1][:top_k]\n","    return [chunk_keys[i] for i in top_indices]\n","\n","\n","def retrieve_enhanced(question: str) -> list[str]:\n","    \"\"\"Rule-augmented RAG: naive retrieval + keyword inclusion rules.\n","\n","    Two rules, applied to the same two chunks naive retrieval selected:\n","      R1 MEASUREMENT  a question about readings/values/metrics must include the\n","                      readings table, and therefore its parents sensors/variables.\n","      R2 CROSS-VARIABLE  a comparison across variables must include all three.\n","    These are the 'inclusion rules' the paper measures; the number of tables they\n","    add is what Figure 4a reports.\n","    \"\"\"\n","    _require_embeddings()\n","    retrieved = set(retrieve_naive(question, top_k=2))\n","    q_lower = question.lower()\n","\n","    measurement_keywords = [\"reading\", \"value\", \"average\", \"max\", \"min\", \"daily\",\n","                            \"hourly\", \"no2\", \"pm2.5\", \"pm10\", \"o3\", \"temperature\",\n","                            \"humidity\", \"traffic\", \"noise\", \"weather\", \"air quality\"]\n","    if any(kw in q_lower for kw in measurement_keywords):\n","        retrieved.add(\"readings\")\n","\n","    # Relationship expansion: readings implies its parent tables are needed too.\n","    if \"readings\" in retrieved:\n","        cross_keywords = [\"compare\", \"correlation\", \"cross\", \"both\", \"ratio\",\n","                          \"vs\", \"versus\", \"and\", \"between\"]\n","        if any(kw in q_lower for kw in cross_keywords):\n","            retrieved.update([\"sensors\", \"variables\"])\n","        if \"broker\" in q_lower or \"sensor\" in q_lower:\n","            retrieved.add(\"sensors\")\n","        if \"theme\" in q_lower or \"units\" in q_lower or \"variable\" in q_lower:\n","            retrieved.add(\"variables\")\n","\n","    return list(retrieved)\n","\n","\n","def build_rag_prompt(question: str, strategy: str = \"naive\") -> str:\n","    \"\"\"Build the RAG prompt with the retrieved schema fragments.\"\"\"\n","    if strategy == \"naive\":\n","        retrieved_keys = retrieve_naive(question)\n","    elif strategy == \"enhanced\":\n","        retrieved_keys = retrieve_enhanced(question)\n","    else:\n","        raise ValueError(f\"Unknown RAG strategy: {strategy}\")\n","\n","    schema_fragments = \"\\n\\n\".join(SCHEMA_CHUNKS[k] for k in retrieved_keys)\n","    return RAG_PROMPT.format(schema_fragments=schema_fragments, question=question)\n","\n","\n","# ── Self-test (only when embeddings are actually available) ─────────────────\n","if RAG_EMBED_READY:\n","    test_questions = [\n","        \"List all sensor names\",\n","        \"What is the average NO2 per sensor?\",\n","        \"Compare NO2 and PM2.5 across brokers\",\n","    ]\n","    print(\"\\nRetrieval tests:\")\n","    for _tq in test_questions:\n","        print(f\"  Q: {_tq}\")\n","        print(f\"    Naive:    {retrieve_naive(_tq)}\")\n","        print(f\"    Enhanced: {retrieve_enhanced(_tq)}\")\n","    print(\"\\nRAG pipeline ready. Strategies: naive, enhanced\")\n","else:\n","    print(\"\\nRAG pipeline NOT ready \\u2014 definitions are in place but will raise if called.\")\n"]},{"cell_type":"markdown","id":"85c63dc5","metadata":{"papermill":{"duration":0.047445,"end_time":"2026-09-20T18:40:09.676392","exception":false,"start_time":"2026-09-20T18:40:09.628947","status":"completed"},"tags":[]},"source":["## 14. Relative Schema Exposure Index (SEI)\n","\n","`compute_sei(question, strategy)` returns the metric the paper defines:\n","\n","```\n","SEI = T_prompt_schema / T_full_schema\n","```\n","\n","the ratio of schema tokens delivered in the prompt to the full DDL token\n","count. Full-schema few-shot always delivers everything, so its SEI = 1.0 by\n","definition; retrieval strategies fall below or above it depending on how many\n","chunks the rules add.\n","\n","> **Order matters.** This section must stay ABOVE the RAG benchmark run. The\n","> driver looks the function up in `globals()` and falls back to 1.0 if it is\n","> missing, which is what silently produced a constant column in the shipped\n","> `rag_experiment_results.csv` (all 8,100 rows at 1.0).\n","\n","Published values (paper): naive 1.04 [0.97-1.06], enhanced 1.28 [0.97-1.52],\n","full-schema 1.0. Per-question values are archived in `n4_rho_analysis.json`\n","(the file keeps its historical name; its strategy keys are `naive`,\n","`enhanced`, `few_shot`).\n"]},{"cell_type":"code","execution_count":14,"id":"1384577c","metadata":{"execution":{"iopub.execute_input":"2026-09-20T18:40:09.775539Z","iopub.status.busy":"2026-09-20T18:40:09.774825Z","iopub.status.idle":"2026-09-20T18:40:17.04553Z","shell.execute_reply":"2026-09-20T18:40:17.044269Z"},"papermill":{"duration":7.322169,"end_time":"2026-09-20T18:40:17.047784","exception":false,"start_time":"2026-09-20T18:40:09.725615","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["few_shot       : SEI_exposure = 1.0000 (min=1.0000, max=1.0000)\n"]},{"name":"stdout","output_type":"stream","text":["naive          : SEI_exposure = 1.0385 (min=0.9706, max=1.0588)\n"]},{"name":"stdout","output_type":"stream","text":["enhanced       : SEI_exposure = 1.2834 (min=0.9706, max=1.5221)\n","Enhanced RAG SEI_exposure by tier:\n"]},{"name":"stdout","output_type":"stream","text":["  T1: 1.0985 (n=30)\n"]},{"name":"stdout","output_type":"stream","text":["  T2: 1.2721 (n=30)\n"]},{"name":"stdout","output_type":"stream","text":["  T3: 1.3816 (n=30)\n"]},{"name":"stdout","output_type":"stream","text":["  T4: 1.2074 (n=30)\n"]},{"name":"stdout","output_type":"stream","text":["  T5: 1.4574 (n=30)\n"]}],"source":["# pyright: reportUnknownMemberType=false, reportUnknownVariableType=false, reportUnknownArgumentType=false, reportMissingTypeStubs=false, reportIndexIssue=false, reportUnknownParameterType=false, reportAttributeAccessIssue=false, reportCallIssue=false, reportOperatorIssue=false, reportConstantRedefinition=false, reportPossiblyUnboundVariable=false, reportMissingImports=false, reportUnnecessaryIsInstance=false, reportPrivateImportUsage=false, reportMissingParameterType=false, reportUnusedImport=false, reportArgumentType=false, reportMissingTypeArgument=false, reportUndefinedVariable=false, reportGeneralTypeIssues=false, reportOptionalMemberAccess=false, reportOptionalSubscript=false, reportOptionalIterable=false, reportOptionalCall=false, reportReturnType=false, reportAssignmentType=false, reportOptionalOperand=false, reportUnnecessaryComparison=false, reportUnusedFunction=false, reportUnusedVariable=false, reportUnboundVariable=false, reportUnknownLambdaType=false, reportUnusedClass=false\n","def compute_sei(question: str, strategy: str) -> float:\n","    \"\"\"Compute schema exposure ratio for a given question and strategy.\"\"\"\n","    if strategy == \"few_shot\":\n","        return 1.0  # Full DDL always included\n","\n","    if strategy == \"naive\":\n","        retrieved_keys = retrieve_naive(question)\n","    elif strategy == \"enhanced\":\n","        retrieved_keys = retrieve_enhanced(question)\n","    else:\n","        return 1.0\n","\n","    # Join with a blank line, matching build_rag_prompt AND the offline script\n","    # that produced the published SEI values. An EMPTY separator here drops the\n","    # token count by 1-2 per join, which shifts SEI by ~0.007-0.015 and made the\n","    # fresh run disagree with the paper (0.9632 vs 0.9706; 1.5074 vs 1.5221).\n","    schema_fragment = \"\\n\\n\".join(SCHEMA_CHUNKS[k] for k in retrieved_keys)\n","    fragment_tokens = len(enc.encode(schema_fragment))\n","    return round(fragment_tokens / SCHEMA_TOKEN_COUNT, 4)\n","\n","# ── Compute average SEI_exposure per strategy ──────────────────\n","for strategy in [\"few_shot\", \"naive\", \"enhanced\"]:\n","    SEIs = [compute_sei(q[\"question\"], strategy) for q in BENCHMARK_QUESTIONS]\n","    mean_sei = np.mean(SEIs)\n","    min_sei = np.min(SEIs)\n","    max_sei = np.max(SEIs)\n","    print(f\"{strategy:15s}: SEI_exposure = {mean_sei:.4f} (min={min_sei:.4f}, max={max_sei:.4f})\")\n","\n","# ── Per-tier breakdown for enhanced RAG ──────────────────────\n","print(\"\\\n","Enhanced RAG SEI_exposure by tier:\")\n","for tier in [\"T1\", \"T2\", \"T3\", \"T4\", \"T5\"]:\n","    tier_qs = [q for q in BENCHMARK_QUESTIONS if q[\"tier\"] == tier]\n","    SEIs = [compute_sei(q[\"question\"], \"enhanced\") for q in tier_qs]\n","    print(f\"  {tier}: {np.mean(SEIs):.4f} (n={len(tier_qs)})\")"]},{"cell_type":"markdown","id":"3e632125","metadata":{"papermill":{"duration":0.053049,"end_time":"2026-09-20T18:40:17.151723","exception":false,"start_time":"2026-09-20T18:40:17.098674","status":"completed"},"tags":[]},"source":["## 15. Benchmark Task Registration (RAG)\n","\n","Registers the schema-delivery evaluation as a `@kbench.task` so the Benchmarks\n","**Task Page** detects the notebook, shows per-question results, and enables\n","**Evaluate More Models**.\n","\n","> Without this cell the Task Page reports *\"No tasks detected\"* and *\"Not\n","> generated\"* — the notebook registers nothing.\n","\n","**This task is retrieval-based, not full-schema.** It takes the delivery strategy\n","as a parameter, so the Task Page can evaluate **naive retrieval** and\n","**rule-augmented retrieval** as separate runs, and it records the delivered\n","`SEI` alongside the verdict. Full-schema few-shot prompting is paper 1's task\n","(`benchmarks/tasks/wganme/urban-observatory-nl-to-sql`); reproducing it here would\n","add nothing.\n","\n","| | |\n","|---|---|\n","| Strategies | `naive` (top-2 chunks), `enhanced` (top-2 + inclusion rules) |\n","| Metric | execution accuracy + delivered `SEI` (Relative Schema Exposure Index) |\n","| Panel | Kaggle Model Proxy (`kbench.llm`); the 10-model panel is Section 6 |\n"]},{"cell_type":"code","execution_count":15,"id":"161503d1","metadata":{"execution":{"iopub.execute_input":"2026-09-20T18:40:17.259049Z","iopub.status.busy":"2026-09-20T18:40:17.258665Z","iopub.status.idle":"2026-09-20T18:53:43.060848Z","shell.execute_reply":"2026-09-20T18:53:43.058189Z"},"papermill":{"duration":805.893829,"end_time":"2026-09-20T18:53:43.09731","exception":false,"start_time":"2026-09-20T18:40:17.203481","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["  kbench task registered: 'Urban Observatory Schema Delivery (RAG)'  (desc 203/255 chars)  (300 runs = 150 questions × 2 strategies)\n"]},{"name":"stdout","output_type":"stream","text":["    delivered SEI [naive   ] mean=1.0385 min=0.9706 max=1.0588\n"]},{"name":"stdout","output_type":"stream","text":["    delivered SEI [enhanced] mean=1.2834 min=0.9706 max=1.5221\n"]},{"name":"stderr","output_type":"stream","text":["[Parallel(n_jobs=1)]: Done   7 tasks      | elapsed:    8.2s\n"]},{"name":"stderr","output_type":"stream","text":["[Parallel(n_jobs=1)]: Done  31 tasks      | elapsed:   42.3s\n"]},{"name":"stderr","output_type":"stream","text":["[Parallel(n_jobs=1)]: Done  71 tasks      | elapsed:  1.8min\n"]},{"name":"stderr","output_type":"stream","text":["[Parallel(n_jobs=1)]: Done 127 tasks      | elapsed:  4.0min\n"]},{"name":"stderr","output_type":"stream","text":["[Parallel(n_jobs=1)]: Done 199 tasks      | elapsed:  8.5min\n"]},{"name":"stderr","output_type":"stream","text":["[Parallel(n_jobs=1)]: Done 287 tasks      | elapsed: 12.8min\n"]},{"name":"stderr","output_type":"stream","text":["[Parallel(n_jobs=1)]: Done 300 out of 300 | elapsed: 13.3min finished\n"]},{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"817a9e6feaba426f9cc6e1eb7d9b514f","version_major":2,"version_minor":0},"text/plain":["Running subtasks:   0%|          | 0/300 [00:00<?, ?it/s]"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["    naive      47/150 = 31.3%\n","    enhanced   56/150 = 37.3%\n"]}],"source":["# pyright: reportAttributeAccessIssue=false, reportGeneralTypeIssues=false, reportMissingImports=false, reportMissingParameterType=false, reportOperatorIssue=false, reportPossiblyUnboundVariable=false, reportUndefinedVariable=false, reportUnknownArgumentType=false, reportUnknownMemberType=false, reportUnknownParameterType=false, reportUnknownVariableType=false, reportUntypedFunctionDecorator=false, reportUnusedImport=false, reportUnusedVariable=false\n","# ════════════════════════════════════════════════════════════════════════════\n","# KAGGLE BENCHMARKS TASK REGISTRATION — schema-delivery (RAG) task\n","# ════════════════════════════════════════════════════════════════════════════\n","# The @kbench.task decorator is what makes the Benchmarks Task Page list this\n","# notebook and enable \"Evaluate More Models\". Without it the page reports\n","# \"No tasks detected\" / \"Not generated\".\n","#\n","# This task is RETRIEVAL-based. Full-schema few-shot prompting is paper 1's task;\n","# paper 2 is about how schema is DELIVERED, so the delivery strategy is a task\n","# parameter and the delivered SEI is recorded with each result.\n","#\n","# Requires MODEL_PROXY_URL + MODEL_PROXY_API_KEY, injected only for notebooks\n","# created through the Benchmarks UI. Skips cleanly when absent.\n","import os\n","from pathlib import Path\n","\n","_KBENCH_TASK_OK = False\n","if bool(os.environ.get(\"KAGGLE_KERNEL_RUN_TYPE\")) or Path(\"/kaggle/working\").exists():\n","    try:\n","        import kaggle_benchmarks as kbench\n","        _KBENCH_TASK_OK = True\n","    except ImportError:\n","        print(\"  kaggle_benchmarks not installed — skipping task registration.\")\n","else:\n","    print(\"  Not on Kaggle — skipping kbench task registration.\")\n","\n","# The four delivery configurations the paper compares. `naive` and `enhanced` are\n","# the two retrieval arms; the full-schema row is kept only as the SEI = 1.0\n","# reference, and is what paper 1's task already covers.\n","_DELIVERY_MODES = (\"naive\", \"enhanced\")\n","\n","if _KBENCH_TASK_OK:\n","    import pandas as _kb_pd\n","\n","    # HARD LIMIT: the Benchmarks platform rejects a task whose `description`\n","    # exceeds 255 characters (\"The description assigned in your @kbench.task\n","    # decorator cannot exceed 255 characters\"). The previous description was 361\n","    # chars and the registration failed. Keep this under 255 — and keep the\n","    # `name` distinct from paper 1's task name so the two are not confused.\n","    _TASK_NAME = \"Urban Observatory Schema Delivery (RAG)\"\n","    _TASK_DESC = (\n","        \"Schema delivery for NL-to-SQL on the Newcastle Urban Observatory IoT \"\n","        \"database: na\\u00efve top-2 retrieval vs rule-augmented retrieval, over 150 \"\n","        \"questions in five complexity tiers, recording the delivered SEI.\"\n","    )\n","    _TASK_DESC = \" \".join(_TASK_DESC.split())          # collapse source line-wraps\n","    assert len(_TASK_DESC) <= 255, (\n","        f\"kbench task description is {len(_TASK_DESC)} chars; the platform limit is \"\n","        f\"255. Shorten _TASK_DESC.\")\n","    assert len(_TASK_NAME) <= 255, (\n","        f\"kbench task name is {len(_TASK_NAME)} chars; the platform limit is 255.\")\n","\n","    @kbench.task(name=_TASK_NAME, description=_TASK_DESC)\n","    def schema_delivery_task(\n","        llm, question: str, gold_sql: str, q_id: str, tier: str, mode: str = \"naive\"\n","    ) -> bool:\n","        \"\"\"True when the retrieved-schema prompt yields SQL matching the gold rows.\n","\n","        `mode` selects the delivery strategy:\n","          naive    - top-2 schema chunks by embedding similarity\n","          enhanced - the same two chunks plus keyword inclusion rules (may add a third)\n","        \"\"\"\n","        if mode not in _DELIVERY_MODES:\n","            raise ValueError(f\"unknown delivery mode {mode!r}; expected {_DELIVERY_MODES}\")\n","        prompt = build_rag_prompt(question, strategy=mode)\n","        with kbench.chats.new(f\"q_{q_id}_{mode}\"):\n","            response = llm.prompt(prompt, extra_api_params={\"max_completion_tokens\": 512})\n","        gen_sql = _extract_sql(response) or \"\"\n","        if not gen_sql:\n","            return False\n","        gold_rows, gold_err = _run_sql(DB_PATH, gold_sql)\n","        if gold_err:\n","            return False\n","        gen_rows, sql_err = _run_sql(DB_PATH, gen_sql)\n","        if sql_err:\n","            return False\n","        return _rows_equal(gen_rows, gold_rows)\n","\n","    # One row per question per strategy, so the Task Page evaluates both delivery\n","    # arms rather than only one.\n","    _kb_eval_df = _kb_pd.DataFrame([\n","        {\"question\": q[\"question\"], \"gold_sql\": q[\"sql\"],\n","         \"q_id\": q[\"id\"], \"tier\": q[\"tier\"], \"mode\": _mode}\n","        for q in BENCHMARK_QUESTIONS\n","        for _mode in _DELIVERY_MODES\n","    ])\n","    print(f\"  kbench task registered: {_TASK_NAME!r}  \"\n","          f\"(desc {len(_TASK_DESC)}/255 chars)  \"\n","          f\"({len(_kb_eval_df)} runs = {len(BENCHMARK_QUESTIONS)} questions × \"\n","          f\"{len(_DELIVERY_MODES)} strategies)\")\n","\n","    # Report the SEI each strategy delivers, straight from the same functions the\n","    # task uses — this is the schema-exposure half of the paper's claim.\n","    try:\n","        for _mode in _DELIVERY_MODES:\n","            _seis = [compute_sei(q[\"question\"], _mode) for q in BENCHMARK_QUESTIONS]\n","            print(f\"    delivered SEI [{_mode:8s}] mean={sum(_seis)/len(_seis):.4f} \"\n","                  f\"min={min(_seis):.4f} max={max(_seis):.4f}\")\n","    except Exception as _sei_err:\n","        print(f\"    (SEI summary unavailable: {type(_sei_err).__name__}: {_sei_err})\")\n","\n","    # evaluate() has crashed on quota exhaustion (403) and discarded partial\n","    # results, so a failure is reported rather than raised.\n","    try:\n","        _kb_runs = schema_delivery_task.evaluate(llm=[kbench.llm],\n","                                                 evaluation_data=_kb_eval_df)\n","    except Exception as _kb_eval_err:\n","        print(f\"  kbench evaluate() interrupted: {type(_kb_eval_err).__name__}: \"\n","              f\"{str(_kb_eval_err)[:200]}\")\n","        _kb_runs = None\n","\n","    try:\n","        _kb_df = (_kb_runs.as_dataframe() if _kb_runs is not None else _kb_pd.DataFrame())\n","        if len(_kb_df):\n","            for _mode in _DELIVERY_MODES:\n","                _sub = _kb_df[_kb_df.get(\"mode\", _mode) == _mode] if \"mode\" in _kb_df else _kb_df\n","                _ok = int(_sub[\"result\"].sum())\n","                print(f\"    {_mode:10s} {_ok}/{len(_sub)} = \"\n","                      f\"{_ok / max(len(_sub), 1) * 100:.1f}%\")\n","        else:\n","            print(\"  kbench evaluation: no results\")\n","    except Exception as _kb_e:\n","        print(f\"  kbench results summary failed: {_kb_e}\")\n","else:\n","    print(\"  Task not registered — the Task Page will show 'No tasks detected'.\")\n"]},{"cell_type":"markdown","id":"dcf9e69d","metadata":{"papermill":{"duration":0.054024,"end_time":"2026-09-20T18:53:43.206365","exception":false,"start_time":"2026-09-20T18:53:43.152341","status":"completed"},"tags":[]},"source":["## 16. Results Integrity Check (read-only)\n","\n","Verifies the stored result files against the published artefact\n","(`all_experiment_results.csv` 4,246 rows / 2,080 correct;\n","`rag_experiment_results.csv` 8,100 rows / 3,875 correct) and warns if the dead\n","`sei` column is present.\n","\n","**This cell replaces the former re-evaluation pass, which wrote back to the\n","results file.** That pass re-ran every generated SQL with a 1-second wall-clock\n","budget and saved its own verdicts over the stored ones. The budget made it\n","load-dependent — the same input produced 2,132 correct on one run and 2,033 on\n","the next, against the published 2,080 — so it silently contradicted the paper.\n","Nothing in this notebook writes to a results file.\n","\n","> Do **not** reintroduce a re-scoring pass. If the stored verdicts need\n","> revisiting, do it offline, in a separate artefact, and version the output.\n"]},{"cell_type":"code","execution_count":16,"id":"87ab3381","metadata":{"execution":{"iopub.execute_input":"2026-09-20T18:53:43.31612Z","iopub.status.busy":"2026-09-20T18:53:43.315602Z","iopub.status.idle":"2026-09-20T18:53:43.75088Z","shell.execute_reply":"2026-09-20T18:53:43.749645Z"},"papermill":{"duration":0.496995,"end_time":"2026-09-20T18:53:43.753293","exception":false,"start_time":"2026-09-20T18:53:43.256298","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["==============================================================\n","RESULTS INTEGRITY CHECK (read-only)\n","==============================================================\n","  all_experiment_results.csv         rows= 4,246 (exp  4,246)  correct=2,080 (exp 2,080)  OK\n"]},{"name":"stdout","output_type":"stream","text":["  rag_experiment_results.csv         rows= 8,100 (exp  8,100)  correct=3,875 (exp 3,875)  OK\n","==============================================================\n"]}],"source":["# pyright: reportMissingImports=false, reportUnknownMemberType=false, reportUnknownVariableType=false\n","# ════════════════════════════════════════════════════════════════════════════\n","# RESULTS INTEGRITY CHECK  (read-only — it never writes)\n","# ════════════════════════════════════════════════════════════════════════════\n","# This cell REPLACES the former \"re-evaluate results\" pass. That pass re-ran\n","# every generated SQL against the database with a 1-second wall-clock budget and\n","# then OVERWROTE the results file with its own verdicts. Two problems:\n","#\n","#   * NONDETERMINISTIC. A 1-second budget means a query that scans the readings\n","#     table can pass or fail depending on machine load. The same input produced\n","#     2,132 correct / 73 errors on one run and 2,033 correct / 518 errors on the\n","#     next.\n","#   * CONTRADICTORY. The published artefact holds 2,080 correct; the pass\n","#     rewrote it to a different number, silently invalidating the paper.\n","#\n","# Paper 2's figures are built from the STORED result files, so the correct\n","# behaviour here is to verify them, not to rewrite them. This cell is read-only\n","# and says so on every line that matters.\n","import csv\n","from pathlib import Path\n","import pandas as pd\n","\n","EXPECTED = {\n","    \"all_experiment_results.csv\":  {\"rows\": 4246, \"correct\": 2080},\n","    \"rag_experiment_results.csv\":  {\"rows\": 8100, \"correct\": 3875},\n","}\n","\n","\n","def _csv_rows(path: Path) -> int:\n","    \"\"\"True CSV record count.\n","\n","    Do NOT use `sum(1 for _ in open(f)) - 1`: the question and SQL fields contain\n","    embedded newlines, so a line count overstates the row count by ~10x\n","    (45,033 lines for a 4,246-row file).\n","    \"\"\"\n","    with open(path, newline=\"\", encoding=\"utf-8\", errors=\"replace\") as fh:\n","        return max(0, sum(1 for _ in csv.reader(fh)) - 1)\n","\n","\n","print(\"=\" * 62)\n","print(\"RESULTS INTEGRITY CHECK (read-only)\")\n","print(\"=\" * 62)\n","for _name, _exp in EXPECTED.items():\n","    _p = Path(WORK_