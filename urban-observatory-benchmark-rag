reportUndefinedVariable=false, reportGeneralTypeIssues=false, reportOptionalMemberAccess=false, reportOptionalSubscript=false, reportOptionalIterable=false, reportOptionalCall=false, reportReturnType=false, reportAssignmentType=false, reportOptionalOperand=false, reportUnnecessaryComparison=false, reportUnusedFunction=false, reportUnusedVariable=false, reportUnboundVariable=false, reportUnknownLambdaType=false, reportUnusedClass=false\n","# GitHub Models API client — loads token from env / Kaggle Secrets.\n","# Routes to Kaggle-AI (kbench/) when prefixed.\n","import os, time, requests\n","from pathlib import Path\n","try:\n","    from dotenv import load_dotenv  # type: ignore[import-not-found]\n","    load_dotenv(dotenv_path=Path(\".env\"), override=False)\n","except ImportError:\n","    pass  # not installed (e.g. Kaggle base image) — env vars / Kaggle Secrets only\n","\n","# ── GitHub Models ──\n","GITHUB_TOKEN = os.environ.get(\"GITHUB_TOKEN\") or os.environ.get(\"GITHUB_PAT\")\n","if not GITHUB_TOKEN:\n","    print(\"WARNING: GITHUB_TOKEN/GITHUB_PAT not set — GitHub Models cells will be skipped.\")\n","    print(\"  Local fix : create .env with  GITHUB_TOKEN=ghp_...\")\n","    print(\"  Kaggle fix: Add-ons > Secrets > attach GITHUB_PAT, then Save Version.\")\n","    GITHUB_TOKEN = None\n","if GITHUB_TOKEN:\n","    print(\"GITHUB_TOKEN loaded: ✓\")\n","else:\n","    print(\"GITHUB_TOKEN not set — GitHub Models will be unavailable.\")\n","\n","GITHUB_API_URL = \"https://models.github.ai/inference/chat/completions\"\n","\n","GITHUB_MODELS_PANEL = [\n","    # Cohere\n","    \"cohere/cohere-command-a\",            # 90.0%\n","    # \"cohere/cohere-command-r-08-2024\",    # OPTED OUT: persistent HTTP 500 auth failure\n","    # \"cohere/cohere-command-r-plus-08-2024\",  # OPTED OUT: HTTP 404 \"no valid deployments\"\n","    # DeepSeek\n","    \"deepseek/deepseek-r1-0528\",          # 80.0%\n","    # Meta Llama family\n","    \"meta/meta-llama-3.1-8b-instruct\",    # 85.0%\n","    \"meta/meta-llama-3.1-405b-instruct\",  # 80.0%\n","    \"meta/llama-3.2-90b-vision-instruct\", # 75.0%\n","    \"meta/llama-3.3-70b-instruct\",        # 80.0%\n","    \"meta/llama-4-maverick-17b-128e-instruct-fp8\",  # 90.0%\n","    \"meta/llama-4-scout-17b-16e-instruct\",  # 85.0%\n","    # Microsoft\n","    \"microsoft/phi-4\",                    # 80.0%\n","    # Mistral\n","    \"mistral-ai/codestral-2501\",          # 85.0%\n","    \"mistral-ai/mistral-medium-2505\",     # 75.0%\n","    \"mistral-ai/mistral-small-2503\",      # 85.0%\n","    # OpenAI\n","    \"openai/gpt-4.1\",                     # 95.0%\n","    \"openai/gpt-4.1-mini\",               # 80.0%\n","    \"openai/gpt-4.1-nano\",               # 85.0%\n","    \"openai/gpt-4o\",                      # 85.0%\n","    \"openai/gpt-4o-mini\",                # 85.0%\n","]\n","\n","# Active panel: GitHub Models when token present; kbench cells\n","# prepend their own ids later.\n","MODEL_PANEL: list[str] = []\n","if GITHUB_TOKEN:\n","    MODEL_PANEL.extend(GITHUB_MODELS_PANEL)\n","if not MODEL_PANEL:\n","    print(\"  WARNING: MODEL_PANEL is empty — no GitHub auth. kbench cells may still populate it.\")\n","\n","# Cooldown registry for GitHub Models.\n","class ModelCooled(Exception):\n","    \"\"\"Shared base: a model is unusable for `soonest_avail - now` seconds.\"\"\"\n","    def __init__(self, model: str, soonest_avail: float, reason: str = \"\"):\n","        self.model = model\n","        self.soonest_avail = soonest_avail\n","        self.reason = reason\n","        wait = max(0.0, soonest_avail - time.time())\n","        super().__init__(f\"{model} cooled ~{wait:.0f}s ({reason})\" if reason\n","                         else f\"{model} cooled ~{wait:.0f}s\")\n","\n","class GitHubModelCooled(ModelCooled):\n","    \"\"\"A GitHub Models id is unusable (404/403/persistent 429/etc.).\"\"\"\n","    pass\n","\n","_GH_COOLDOWN: dict[str, float] = {}\n","_GH_DEFAULT_COOLDOWN = 60.0\n","_GH_HARD_COOLDOWN = 24 * 3600.0  # 401/403/404/400 — model unusable for the run\n","\n","def _gh_available(model: str) -> bool:\n","    return _GH_COOLDOWN.get(model, 0.0) <= time.time()\n","\n","def _gh_cool(model: str, secs: float, reason: str) -> None:\n","    _GH_COOLDOWN[model] = time.time() + max(secs, _GH_DEFAULT_COOLDOWN)\n","    print(f\"  ✗ GH cooldown ({model}) ~{secs:.0f}s — {reason}\")\n","\n","def github_models_chat(\n","    messages: list[dict[str, str]],\n","    model: str = \"openai/gpt-4o-mini\",\n","    max_tokens: int = 512,\n","    temperature: float = 0.0,\n","    retries: int = 6,\n","    base_sleep: float = 15.0\n",") -> str:\n","    \"\"\"Send a chat request to GitHub Models (or routed to kbench).\n","    Smart-fail: cools the model and raises GitHubModelCooled / ModelCooled\n","    so the bench loop rotates instead of returning an error string.\"\"\"\n","    if model.startswith(\"kbench/\"):\n","        _try_kb = globals().get(\"_try_kbench\")\n","        if _try_kb is None:\n","            raise RuntimeError(\n","                \"kbench route requested but _try_kbench not defined \"\n","                \"(run the Kaggle AI setup cell first)\"\n","            )\n","        return _try_kb(messages, model[len(\"kbench/\"):], max_tokens, temperature)\n","    # GitHub Models from here on.\n","    if not GITHUB_TOKEN:\n","        _gh_cool(model, _GH_HARD_COOLDOWN, \"no GITHUB_TOKEN\")\n","        raise GitHubModelCooled(model, _GH_COOLDOWN[model], \"no token\")\n","    if model in _GH_COOLDOWN and _GH_COOLDOWN[model] > time.time():\n","        raise GitHubModelCooled(model, _GH_COOLDOWN[model], \"still cooled\")\n","    headers = {\n","        \"Authorization\": f\"Bearer {GITHUB_TOKEN}\",\n","        \"Content-Type\": \"application/json\"\n","    }\n","    _is_gh_reasoning = (\n","        \"deepseek-r1\" in model.lower()\n","        or \"phi-4-mini-reasoning\" in model.lower()\n","    )\n","    _eff_max_tokens = max(max_tokens, 4096) if _is_gh_reasoning else max_tokens\n","    payload: dict[str, object] = {\n","        \"model\": model,\n","        \"messages\": messages,\n","        \"max_tokens\": _eff_max_tokens,\n","        \"temperature\": temperature,\n","    }\n","    MAX_SLEEP = 120.0\n","    last_retry_after = base_sleep\n","    for attempt in range(retries):\n","        try:\n","            resp = requests.post(GITHUB_API_URL, headers=headers, json=payload, timeout=60)\n","        except Exception as exc:\n","            print(f\"  network error ({model}, attempt {attempt+1}): {exc}\")\n","            time.sleep(min(base_sleep * (2 ** attempt), MAX_SLEEP))\n","            continue\n","        if resp.status_code == 200:\n","            _msg = resp.json()[\"choices\"][0].get(\"message\", {})\n","            _content = _msg.get(\"content\")\n","            if isinstance(_content, str) and _content.strip():\n","                return _content\n","            _reasoning = _msg.get(\"reasoning\")\n","            if isinstance(_reasoning, str) and _reasoning.strip():\n","                return _reasoning\n","            print(f\"  empty content from {model} (attempt {attempt+1})\")\n","            time.sleep(2.0)\n","            continue\n","        elif resp.status_code == 429:\n","            raw_retry = float(resp.headers.get(\"retry-after\", base_sleep * (2 ** attempt)))\n","            last_retry_after = min(raw_retry, MAX_SLEEP)\n","            if attempt == retries - 1:\n","                _gh_cool(model, last_retry_after, \"429\")\n","                raise GitHubModelCooled(model, _GH_COOLDOWN[model], \"429\")\n","            print(f\"  429 rate-limit ({model}), sleeping {last_retry_after:.0f}s ...\")\n","            time.sleep(last_retry_after)\n","        elif resp.status_code in (400, 401, 403, 404, 500):\n","            _gh_cool(model, _GH_HARD_COOLDOWN,\n","                     f\"HTTP {resp.status_code}: {resp.text[:120]}\")\n","            raise GitHubModelCooled(model, _GH_COOLDOWN[model],\n","                                    f\"HTTP {resp.status_code}\")\n","        else:\n","            _gh_cool(model, _GH_DEFAULT_COOLDOWN,\n","                     f\"HTTP {resp.status_code}: {resp.text[:120]}\")\n","            raise GitHubModelCooled(model, _GH_COOLDOWN[model],\n","                                    f\"HTTP {resp.status_code}\")\n","    # Force a long cooldown on full retry exhaustion so a single slow model\n","    # (e.g. phi-4-mini-reasoning timing out at 60s × 6 retries) does not keep\n","    # burning time across every subsequent row.\n","    _gh_cool(model, max(last_retry_after, 600.0), \"retries exhausted\")\n","    raise GitHubModelCooled(model, _GH_COOLDOWN[model], \"exhausted\")\n","\n","\n","# ── GitHub Models retirement (2026) ──────────────────────────────────────────\n","# The GitHub Models inference endpoint is retired: every id in\n","# GITHUB_MODELS_PANEL returns HTTP 410 \"github_models_retirement_brownout\".\n","# Leaving them in MODEL_PANEL satisfies the benchmark runner's guard but then\n","# spends the entire session cooling 18 dead endpoints, so no run ever finishes.\n","# Probe once; if dead, drop them and let the Kaggle-AI (kbench) cell populate\n","# MODEL_PANEL instead.\n","GH_MODELS_AVAILABLE = False\n","if GITHUB_TOKEN:\n","    try:\n","        _probe = requests.post(\n","            GITHUB_API_URL,\n","            headers={\"Authorization\": f\"Bearer {GITHUB_TOKEN}\",\n","                     \"Content-Type\": \"application/json\"},\n","            json={\"model\": \"openai/gpt-4o-mini\",\n","                  \"messages\": [{\"role\": \"user\", \"content\": \"Reply with exactly: PONG\"}],\n","                  \"max_tokens\": 10},\n","            timeout=30,\n","        )\n","        GH_MODELS_AVAILABLE = (_probe.status_code == 200)\n","        _pcode = \"\"\n","        if _probe.status_code != 200:\n","            try:\n","                _pcode = _probe.json().get(\"error\", {}).get(\"code\", \"\")\n","            except Exception:\n","                _pcode = \"\"\n","        print(f\"GitHub Models endpoint probe -> HTTP {_probe.status_code}\"\n","              + (f\" ({_pcode})\" if _pcode else \"\"))\n","    except Exception as _probe_exc:\n","        print(f\"GitHub Models endpoint probe failed: {_probe_exc}\")\n","else:\n","    print(\"GitHub Models endpoint probe skipped - no GITHUB_TOKEN.\")\n","\n","if not GH_MODELS_AVAILABLE:\n","    _gh_dropped = [m for m in MODEL_PANEL if m in GITHUB_MODELS_PANEL]\n","    MODEL_PANEL = [m for m in MODEL_PANEL if m not in GITHUB_MODELS_PANEL]\n","    # Clear the env vars too: cells 51 and 58 re-read GITHUB_TOKEN from the\n","    # environment, so nulling the local name alone would not stop them routing\n","    # to the dead endpoint.\n","    os.environ.pop(\"GITHUB_TOKEN\", None)\n","    os.environ.pop(\"GITHUB_PAT\", None)\n","    GITHUB_TOKEN = None\n","    print(f\"GitHub Models RETIRED -- dropped {len(_gh_dropped)} dead models \"\n","          f\"from MODEL_PANEL; Kaggle-AI (kbench) will populate it.\")\n","else:\n","    print(f\"GitHub Models available -- kept {len(GITHUB_MODELS_PANEL)} models.\")\n","\n","# Quick connectivity test\n","if GITHUB_TOKEN:\n","    try:\n","        _test = github_models_chat(\n","            [{\"role\": \"user\", \"content\": \"Reply with exactly: PONG\"}],\n","            model=\"openai/gpt-4o-mini\", max_tokens=10,\n","        )\n","        print(f\"API test → {_test.strip()}\")\n","    except Exception as _e:\n","        print(f\"API test skipped (no working route): {_e}\")\n","else:\n","    print(\"API test skipped — no GITHUB_TOKEN in environment.\")\n","print(\"github_models_chat() ready. MODEL_PANEL:\", MODEL_PANEL)\n"]},{"cell_type":"markdown","id":"4a4a6609","metadata":{"papermill":{"duration":0.041189,"end_time":"2026-09-20T18:36:11.948947","exception":false,"start_time":"2026-09-20T18:36:11.907758","status":"completed"},"tags":[]},"source":["## 6. Model Provider — Kaggle AI (kbench)\n"]},{