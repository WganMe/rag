  _fout = None\n","    try:\n","        _fout = open(RAG_RESULTS_CSV, \"a\", newline=\"\", encoding=\"utf-8\")\n","        _writer = csv.DictWriter(_fout, fieldnames=RAG_FIELDNAMES)\n","        if not _csv_exists:\n","            _writer.writeheader()\n","        for _strat_label, _rag_mode in RAG_STRATEGIES:\n","            print(f\"\\n{'#'*60}\")\n","            print(f\"# Strategy: {_strat_label}  (RAG mode: {_rag_mode})\")\n","            print(f\"{'#'*60}\")\n","\n","            # Build pending queues per model for this strategy\n","            _pending: dict[str, deque] = {m: deque() for m in MODEL_PANEL}\n","            for _q in BENCHMARK_QUESTIONS:\n","                for _m in MODEL_PANEL:\n","                    if (str(_q[\"id\"]), str(_m), _strat_label) not in _done:\n","                        _pending[_m].append(_q)\n","            _total = sum(len(v) for v in _pending.values())\n","            _models_active = [m for m in MODEL_PANEL if _pending[m]]\n","            # Pre-filter: drop models still in long cooldown from prior cells/strategies\n","            _now_t = time.time()\n","            for _m in list(_models_active):\n","                _cd_until = _gh_cool_reg.get(_m, 0)\n","                if _m.startswith(\"kbench/\"):\n","                    _cd_until = max(_cd_until, globals().get(\"_KBENCH_COOLDOWN\", {}).get(_m[len(\"kbench/\"):], 0))\n","                if _cd_until - _now_t > 600:\n","                    _models_active.remove(_m)\n","                    print(f\"    ⏭ {_m.split(chr(47))[-1]} still cooled ~{_cd_until - _now_t:.0f}s — skipped\")\n","            _skip_msg = f\" ({sum(1 for k in _done if k[2] == _strat_label)} already done, skipped)\" if _done else \"\"\n","            print(f\"  Work queue: {_total} pending calls \"\n","                  f\"across {len(_models_active)} models{_skip_msg}\")\n","\n","            if _total == 0:\n","                print(\"  Nothing to do — all pairs complete.\")\n","                continue\n","\n","            _strat_i = 0\n","            _consecutive_stalls = 0\n","            while _models_active:\n","                _progress = False\n","                for _model in list(_models_active):\n","                    if not _pending[_model]:\n","                        _models_active.remove(_model)\n","                        continue\n","                    # Skip GitHub Models in cooldown\n","                    if not _gh_avail_fn(_model):\n","                        continue\n","                        continue\n","\n","                    _q = _pending[_model].popleft()\n","                    _i += 1\n","                    _strat_i += 1\n","\n","                    # Build RAG prompt\n","                    _prompt = build_rag_prompt(_q[\"question\"], strategy=_rag_mode)\n","                    _prompt_tokens = len(enc.encode(_prompt))\n","                    _sei = compute_sei(_q[\"question\"], _rag_mode) if 'compute_sei' in globals() else 1.0\n","\n","                    _t0 = time.time()\n","                    try:\n","                        _raw = github_models_chat(\n","                            [{\"role\": \"user\", \"content\": _prompt}],\n","                            model=_model, max_tokens=512, temperature=0.0,\n","                            retries=1,\n","                        )\n","                    except _COOLED_CLS as _ec:\n","                        _pending[_model].appendleft(_q)\n","                        _i -= 1\n","                        _strat_i -= 1\n","                        _wait_s = max(0.0, getattr(_ec, \"soonest_avail\", 0.0) - time.time())\n","                        _disp = _model.split(\"/\")[-1] or _model\n","                        _reason = getattr(_ec, \"reason\", \"cooled\")\n","                        print(f\"  ~ {_disp} cooled ~{_wait_s:.0f}s \"\n","                              f\"({_reason}); switching model\")\n","                        if _wait_s > 3600 and _model in _models_active:\n","                            _models_active.remove(_model)\n","                            print(f\"    (removed {_disp} from active rotation: cooled >1h)\")\n","                        continue\n","                    except Exception as _e:\n","                        _raw = f\"ERROR: {_e}\"\n","                    _lat = time.time() - _t0\n","\n","                    _gen = _extract_sql(_raw) or \"\"\n","                    _gold_rows, _gold_err = _run_sql(DB_PATH, _q[\"sql\"])\n","                    _err_msg, _correct = \"\", False\n","                    if _gold_err:\n","                        _err_msg = f\"gold-error: {_gold_err}\"\n","                    elif not _gen:\n","                        _err_msg = \"empty SQL\"\n","                    else:\n","                        _gen_rows, _sql_err = _run_sql(DB_PATH, _gen)\n","                        if _sql_err:\n","                            # ── Self-correction: one retry with error feedback ──\n","                            try:\n","                                _fix_prompt = (\n","                                    f\"Your SQL query:\\n{_gen}\\n\\n\"\n","                                    f\"failed with error: {_sql_err}\\n\\n\"\n","                                    f\"Original question: {_q['question']}\\n\"\n","                                    f\"Fix the query using only standard SQLite \"\n","                                    f\"functions and columns from the schema.\"\n","                                )\n","                                _raw2 = github_models_chat(\n","                                    [{\"role\": \"user\", \"content\": _prompt},\n","                                     {\"role\": \"assistant\", \"content\": _gen},\n","                                     {\"role\": \"user\", \"content\": _fix_prompt}],\n","                                    model=_model, max_tokens=512, temperature=0.0,\n","                                    retries=1,\n","                                )\n","                                _gen2 = _extract_sql(_raw2) or \"\"\n","                                if _gen2 and _gen2 != _gen:\n","                                    _gen_rows2, _sql_err2 = _run_sql(DB_PATH, _gen2)\n","                                    if not _sql_err2:\n","                                        _gen, _gen_rows, _sql_err = _gen2, _gen_rows2, \"\"\n","                                        print(f\"    ↻ self-corrected\")\n","                            except _COOLED_CLS:\n","                                pass\n","                            except Exception:\n","                                pass\n","                        if _sql_err:\n","                            _err_msg = _sql_err\n","                        else:\n","                            _correct = _rows_equal(_gen_rows, _gold_rows)\n","\n","                    _row = {\n","                        \"q_id\": _q[\"id\"], \"tier\": _q[\"tier\"],\n","                        \"domain\": _q.get(\"domain\", \"\"), \"model\": _model,\n","                        \"strategy\": _strat_label,\n","                        \"question\": _q[\"question\"], \"gold_sql\": _q[\"sql\"],\n","                        \"generated_sql\": _gen, \"correct\": int(_correct),\n","                        \"error_msg\": _err_msg, \"latency_s\": round(_lat, 2),\n","                        \"sei\": _sei, \"prompt_tokens\": _prompt_tokens,\n","                    }\n","                    _writer.writerow(_row)\n","                    _fout.flush()\n","\n","                    if _i % 200 == 0 or _i == 50:\n","                        _snapshot_results_csv(reason=f\"rag@row{_i}\", csv_name=\"rag_experiment_results.csv\")\n","\n","                    _status = \"PASS\" if _correct else (\"ERR\" if _err_msg else \"WRONG\")\n","                    _disp = _model.split(\"/\")[-1] or _model\n","                    print(f\"  [{_strat_i}/{_total}] {_q['id']} {_q['tier']} \"\n","                          f\"{_disp} ({_strat_label}): {_status} ({_lat:.1f}s) \"\n","                          f\"SEI={_sei:.3f}\")\n","                    _progress = True\n","                    _consecutive_stalls = 0\n","                    time.sleep(_INTER_PAUSE)\n","                    if not _pending[_model]:\n","                        _models_active.remove(_model)\n","\n","                # All active models tried this round — sleep until soonest\n","                if not _progress and _models_active:\n","                    _now = time.time()\n","                    _gh_ts = [t for (m, t) in _gh_cool_reg.items()\n","                              if m in _models_active and t > _now]\n","                    _ol_ts = [t for (m, t) in globals().get(\"_ol_reg\", {}).items()\n","                              if m in _models_active and t > _now]\n","                    _kb_reg = globals().get(\"_KBENCH_COOLDOWN\", {})\n","                    _kb_ts = [t for (m, t) in _kb_reg.items()\n","                              if f\"kbench/{m}\" in _models_active and t > _now]\n","                    _ts = _gh_ts + _ol_ts + _kb_ts\n","                    _wait = (min(_ts) - _now) if _ts else 30.0\n","                    _wait = max(5.0, min(_wait, 120.0))\n","                    _consecutive_stalls += 1\n","                    if _consecutive_stalls >= 3:\n","                        _stuck = list(_models_active)\n","                        _stuck_disp = [m.split(\"/\")[-1] for m in _stuck]\n","                        print(f\"  ⛔ {_consecutive_stalls} consecutive stalls — \"\n","                              f\"dropping stuck models: {_stuck_disp}\")\n","                        for _sm in _stuck:\n","                            _models_active.remove(_sm)\n","                        break\n","                    print(f\"  ⏸ all {len(_models_active)} active models cooled; \"\n","                          f\"sleeping {_wait:.0f}s … (stall {_consecutive_stalls}/3)\")\n","                    time.sleep(_wait)\n","    finally:\n","        if _fout is not None:\n","            _fout.close()\n","        _LAST_SNAPSHOT_T[0] = 0.0\n","        _snapshot_results_csv(reason=\"rag-final\", csv_name=\"rag_experiment_results.csv\")\n","\n","    # ── Summary ───────────────────────────────────────────────\n","    df_rag = pd.read_csv(RAG_RESULTS_CSV)\n","    # Dual-name tolerance. The PUBLISHED `rag_experiment_results.csv` carries the\n","    # column as `rho_exposure`; runs from this revision write `sei`. The paper\n","    # calls the metric SEI (Relative Schema Exposure Index), so `sei` is the\n","    # going-forward name, but the published artefact must keep working.\n","    if \"sei\" not in df_rag.columns and \"rho_exposure\" in df_rag.columns:\n","        df_rag = df_rag.rename(columns={\"rho_exposure\": \"sei\"})\n","        print(\"  note: reading the published column name `rho_exposure` as `sei`\")\n","    print(f\"\\nRAG benchmark complete: {len(df_rag)} rows\")\n","    # The `sei` COLUMN comes from the results CSV. In the published file that\n","    # column is the historical dead one (`rho_exposure`, 1.0 for every row),\n","    # because the original run computed it before compute_rho_exposure existed.\n","    # Printing it as \"SEI\" is therefore misleading, so it is labelled as the\n","    # stored column and the COMPUTED SEI is reported next to it.\n","    _col_const = (df_rag[\"sei\"].nunique(dropna=True) == 1) if \"sei\" in df_rag.columns else False\n","    for _s in [\"naive_rag\", \"enhanced_rag\"]:\n","        _sub = df_rag[df_rag[\"strategy\"] == _s]\n","        if not len(_sub):\n","            continue\n","        _acc = _sub[\"correct\"].sum() / len(_sub) * 100\n","        _stored = _sub[\"sei\"].mean() if \"sei\" in _sub.columns else float(\"nan\")\n","        _mode = \"naive\" if _s.startswith(\"naive\") else \"enhanced\"\n","        _computed = float(\"nan\")\n","        if \"compute_sei\" in globals() and \"BENCHMARK_QUESTIONS\" in globals():\n","            try:\n","                _computed = float(np.mean(\n","                    [compute_sei(_q[\"question\"], _mode) for _q in BENCHMARK_QUESTIONS]))\n","            except Exception as _e:\n","                print(f\"    (computed SEI unavailable: {_e})\")\n","        _flag = \"   <- CONSTANT, not usable\" if _col_const else \"\"\n","        print(f\"  {_s:<16} {int(_sub['correct'].sum())}/{len(_sub)} = {_acc:.1f}%\"\n","              f\"   stored column SEI={_stored:.3f}{_flag}\")\n","        print(f\"  {'':<16} computed SEI={_computed:.4f}  (from the schema chunks)\")\n","    if _col_const:\n","        print(\"\\n  NOTE: the stored `sei` column is constant across every row, so it\")\n","        print(\"        does NOT measure what was delivered. Use the computed SEI above\")\n","        print(\"        (or n4_rho_analysis.json) for the paper's schema-exposure numbers.\")\n","\n","    # ── Combine with few-shot results ─────────────────────────\n","    _fs_csv = Path(WORK_ROOT) / \"data_export\" / \"all_experiment_results.csv\"\n","    if _fs_csv.exists():\n","        df_fs = pd.read_csv(_fs_csv)\n","        if \"strategy\" not in df_fs.columns:\n","            df_fs[\"strategy\"] = \"few_shot\"\n","        if \"sei\" not in df_fs.columns and \"rho_exposure\" in df_fs.columns:\n","            df_fs = df_fs.rename(columns={\"rho_exposure\": \"sei\"})\n","        if \"sei\" not in df_fs.columns:\n","            df_fs[\"sei\"] = 1.0   # full DDL is always delivered, so SEI = 1 by definition\n","        if \"prompt_tokens\" not in df_fs.columns:\n","            df_fs[\"prompt_tokens\"] = pd.NA\n","        df_combined = pd.concat([df_fs, df_rag], ignore_index=True)\n","        _out = Path(WORK_ROOT) / \"data_export\" / \"all_experiment_results_combined.csv\"\n","        df_combined.to_csv(_out, index=False)\n","        print(f\"\\n  Combined: {len(df_combined)} rows saved to {_out}\")\n","        print(f\"    few_shot:     {len(df_fs)} rows\")\n","