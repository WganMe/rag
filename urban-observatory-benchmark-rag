IRS = {\"archive\", \"archive_bulk\", \"kaggle_output\", \"kbench_output\",\n","                 \"_results_snapshot\", \"_preflight_snapshot\", \"__pycache__\"}\n","_EXCLUDE_NAMES = {\"kbench_few_shot.log\", \"kbench_few_shot_run.log\",\n","                  \"urban-observatory-benchmark.log\", \"analyze_rerun.log\"}\n","_MAX_FILE_BYTES = 200 * 1024 * 1024   # safety: skip anything absurd\n","\n","def _ok(p: Path) -> bool:\n","    if any(part in _EXCLUDE_DIRS for part in p.parts):\n","        return False\n","    if p.name in _EXCLUDE_NAMES:\n","        return False\n","    if \".bak\" in p.name or p.name.endswith(\".log.bak\"):\n","        return False\n","    if not p.is_file() or p.stat().st_size == 0:\n","        return False\n","    if p.stat().st_size > _MAX_FILE_BYTES:\n","        print(f\"    ! skipping {p.name} (> {_MAX_FILE_BYTES/1e6:.0f} MB)\")\n","        return False\n","    return True\n","\n","_files: list[Path] = []\n","for _n in _INCLUDE_EXACT:\n","    _p = _SRC / _n\n","    if _p.exists() and _ok(_p):\n","        _files.append(_p)\n","for _d in _INCLUDE_DIRS:\n","    _dd = _SRC / _d\n","    if _dd.is_dir():\n","        for _p in sorted(_dd.rglob(\"*\")):\n","            if _ok(_p):\n","                _files.append(_p)\n","\n","# De-duplicate while preserving order.\n","_seen: set[Path] = set()\n","_files = [p for p in _files if not (p in _seen or _seen.add(p))]\n","\n","_OUT = _ROOT / \"urban-observatory-benchmark-rag-output.zip\"\n","_manifest = {\n","    \"created_utc\": datetime.now(timezone.utc).isoformat(),\n","    \"source_root\": str(_SRC),\n","    \"note\": \"Urban Observatory NL-to-SQL benchmark artefacts. \"\n","            \"Excluded by design: multi-MB *.log run logs, *.bak_* backups, \"\n","            \"and the archive_bulk/ parquet snapshot.\",\n","    \"files\": {},\n","}\n","\n","if not _files:\n","    print(f\"SKIP packaging — no artefacts found under {_SRC}.\")\n","    print(\"     Run the benchmark / table / figure cells first