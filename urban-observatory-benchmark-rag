xist_ok=True)\n","        paths.append(p)\n","    return paths\n","\n","# Static path to the pre-converted bulk archive (Parquet, 2013-06 → present).\n","# Same relative location in both environments:\n","#   Colab : /content/drive/MyDrive/Colab Notebooks/data_export/archive_bulk\n","#   Local : <repo>/data_export/archive_bulk\n","# On Kaggle the per-year archive dirs live directly under DATA_EXPORT (the dataset root).\n","# Locally / in Colab they sit under DATA_EXPORT/archive_bulk/.\n","import re as _re_year\n","_YEAR_PAT = _re_year.compile(r'^\\d{4}$')\n","if _IN_KAGGLE and DATA_EXPORT.exists() and any(\n","    _YEAR_PAT.fullmatch(p.name) for p in DATA_EXPORT.iterdir() if p.is_dir()\n","):\n","    ARCHIVE_BULK = DATA_EXPORT\n","else:\n","    ARCHIVE_BULK = DATA_EXPORT / \"archive_bulk\"\n","ARCHIVE_BULK_AVAILABLE = ARCHIVE_BULK.exists() and any(ARCHIVE_BULK.rglob('*.parquet'))\n","\n","print(f\"cwd            = {os.getcwd()}\")\n","print(f\"DATA_EXPORT    = {DATA_EXPORT}\")\n","print(f\"ARCHIVE_BULK   = {ARCHIVE_BULK}  (available={ARCHIVE_BULK_AVAILABLE})\")\n","\n","# ── Tee stdout to a log file so all printed output is captured ────────────────\n","import sys as _sys\n","_LOG_PATH = SAVE_ROOTS[0] / \"notebook_output.log\"\n","\n","class _Tee:\n","    \"\"\"Write to both the original stdout and a log file.\"\"\"\n","    def __init__(self, log_path, original):\n","        self._original = original\n","        self._log = open(log_path, \"w\", encoding=\"utf-8\", buffering=1)\n","    def write(self, data):\n","        self._original.write(data)\n","        self._log.write(data)\n","    def flush(self):\n","        self._original.flush()\n","        self._log.flush()\n","    def close_log(self):\n","        self._log.close()\n","    # Delegate everything else (isatty, fileno, etc.) to the original stream.\n","    def __getattr__(self, name):\n","        return getattr(self._original, name)\n","\n","_orig_stdout = _sys.stdout  # preserve IPython's per-cell stream\n"