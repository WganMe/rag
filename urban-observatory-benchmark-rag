roduced every number it reports, so this section recomputes them here.\n","#\n","# WHAT IT PRODUCES (all from data already on disk; NO API calls)\n","#\n","# Statistics reported in the manuscript's \"Statistical Analysis\" section:\n","#     - Fisher's exact test      (pairwise + per-tier comparisons)\n","#     - McNemar's exact test     (paired, three-test family)\n","#     - Holm-Bonferroni          (step-down, over the 3-test family)\n","#     - Benjamini-Hochberg FDR   (over the 3-test family)\n","#     - Cohen's h                (alongside every p-value)\n","#\n","# Tables:  tab_strategy_accuracy.tex   overall accuracy by strategy, 2 panels\n","#          tab_tier_accuracy.tex       accuracy by tier x strategy\n","#          tab_error_breakdown.tex     error category x strategy\n","#          tab_tier_correction.tex     published vs corrected 29-model tiers\n","#\n","# Figure:  fig_accuracy_sei.pdf        enhanced-RAG accuracy vs per-query SEI\n","#\n","# PANEL DISCIPLINE (unchanged from Section 21 — do not mix these):\n","#     ten-model panel (n=10 models, 300 pairs/tier) -> tab_strategy (upper block),\n","#         tab_tier_accuracy, and ALL paired inference (McNemar / Holm / BH)\n","#     27-model panel  (n=27 models, 810 pairs/tier) -> tab_strategy (lower block),\n","#         fig_accuracy_sei, and the RAG columns of tab_error_breakdown\n","#     29-model archive (all_experiment_results.csv, 4,246 queries) -> the\n","#         few-shot column of tab_error_breakdown and tab_tier_correction\n","#\n","# PROVENANCE NOTE — tab_tier_correction and the few-shot arm of\n","# tab_error_breakdown describe the COMPANION STUDY's archive (IEEE Access:\n","# 29 models, original one-second execution bound), not paper 2's own arms. They\n","# are reproduced here only so that every table and figure in the manuscript can\n","# be regenerated from one run. They are NOT evidence for paper 2's RAG claim.\n","import collections\n","import json\n","import math\n","import re\n","import sqlite3\n","from pathlib import Path\n","\n","import numpy as np\n","import pandas as pd\n","from scipy.stats import binomtest, fisher_exact\n","\n","try:\n","    import matplotlib\n","    matplotlib.use(\"Agg\")\n","    import matplotlib.pyplot as plt\n","    _MPL_OK = True\n","except Exception as _mpl_err:                                   # pragma: no cover\n","    _MPL_OK = False\n","    print(f\"[stats] matplotlib unavailable ({_mpl_err}) — fig_accuracy_sei will be skipped.\")\n","\n","_ROOT = Path(globals().get(\"WORK_ROOT\", \".\"))\n","_FIG = _ROOT / \"data_export\" / \"figures_paper2\"\n","_TAB = _ROOT / \"data_export\" / \"tables\"\n","_FIG.mkdir(parents=True, exist_ok=True)\n","_TAB.mkdir(parents=True, exist_ok=True)\n","\n","TIERS = globals().get(\"TIERS\", [\"T1\", \"T2\", \"T3\", \"T4\", \"T5\"])\n","TIER_LBL = globals().get(\"TIER_LBL\", [\"T1\\nsimple\", \"T2\", \"T3\", \"T4\", \"T5\\ncomplex\"])\n","\n","# ── resolve inputs without relying on cell ordering (as in Section 21) ───────\n","_SKIP = {\".git\", \"__pycache__\", \"archive_bulk\", \"node_modules\",\n","         \".virtual_documents\", \".ipynb_checkpoints\", \"kaggle_output\", \"kbench_output\"}\n","\n","\n","def _find(name):\n","    \"\"\"Locate a data file anywhere under the working root (bounded depth).\"\"\"\n","    for c in (_ROOT / name, _ROOT / \"data_export\" / name,\n","              _ROOT / \"data_export\" / \"data_export\" / name, Path(name)):\n","        if c.exists() and c.stat().st_size > 1_000:\n","            return c\n","    stack, seen = [(Path(_ROOT), 0)], set()\n","    while stack:\n","        d, depth = stack.pop(0)\n","        if depth > 5 or str(d) in seen:\n","            continue\n","        seen.add(str(d))\n","        try:\n","            entries = sorted(d.iterdir())\n","        except (OSError, PermissionError):\n","            continue\n","        for e in entries:\n","            if e.is_file() and e.name == name and e.stat().st_size > 1_000:\n","                return e\n","            if e.is_dir() and e.name not in _SKIP and not e.is_symlink():\n","                stack.append((e, depth + 1))\n","    return None\n","\n","\n","_NEEDED = [\"rag_experiment_results.csv\", \"few_shot_rerun_kbench_results.csv\",\n","           \"all_experiment_results.csv\", \"n4_rho_analysis.json\",\n","           \"experiment_b_kbench_results.csv\", \"benchmark_questions.json\"]\n","_P = {n: _find(n) for n in _NEEDED}\n","for _n, _p in _P.items():\n","    print(f\"  {'OK     ' if _p else 'MISSING'} {_n}\")\n","if _P[\"rag_experiment_results.csv\"] is None:\n","    raise FileNotFoundError(\n","        \"rag_experiment_results.csv is required. Attach \"\n","        \"wganme/urban-observatory-results or run the RAG cells first.\")\n","\n","\n","def _load(name):\n","    return (pd.read_csv(_P[name]) if _P[name].name.endswith(\".csv\")\n","            else json.loads(_P[name].read_text()))\n","\n","\n","rag = _load(\"rag_experiment_results.csv\")\n","few = _load(\"few_shot_rerun_kbench_results.csv\") if _P[\"few_shot_rerun_kbench_results.csv\"] else None\n","allf = _load(\"all_experiment_results.csv\") if _P[\"all_experiment_results.csv\"] else None\n","N4 = _load(\"n4_rho_analysis.json\") if _P[\"n4_rho_analysis.json\"] else {}\n","ZB = _load(\"experiment_b_kbench_results.csv\") if _P[\"experiment_b_kbench_results.csv\"] else None\n","QUESTIONS = _load(\"benchmark_questions.json\") if _P[\"benchmark_questions.json\"] else []\n","\n","for _d in (rag, few, allf):\n","    if _d is not None and \"model\" in _d.columns:\n","        _d[\"model\"] = _d[\"model\"].astype(str).str.replace(r\"^kbench/\", \"\", regex=True)\n","\n","TEN = sorted(set(few[\"model\"])) if few is not None else []\n","ALL27 = sorted(set(rag[\"model\"]))\n","FEW_OK, ALLF_OK = few is not None, allf is not None\n","print(f\"\\npanels : ten-model n={len(TEN) if TEN else 'n/a'} | rag n={len(ALL27)}\"\n","      f\" | few-shot archive {'present' if FEW_OK else 'absent'}\"\n","      f\" | 29-model archive {'present' if ALLF_OK else 'absent'}\")\n","\n","\n","# ════════════════════════════════════════════════════════════════════════════\n","# 22.1  Statistical estimators\n","# ════════════════════════════════════════════════════════════════════════════\n","def wilson_ci(k: int, n: int, z: float = 1.959963984540054) -> tuple:\n","    \"\"\"Wilson score interval, in PERCENT. Robust at small n and near 0/1.\"\"\"\n","    if n == 0:\n","        return (float(\"nan\"), float(\"nan\"))\n","    p = k / n\n","    d = 1 + z * z / n\n","    c = (p + z * z / (2 * n)) / d\n","    h = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / d\n","    return (100 * max(0.0, c - h), 100 * min(1.0, c + h))\n","\n","\n","def cohens_h(p1: float, p2: float) -> float:\n","    \"\"\"Cohen's h for two proportions. |h| < 0.2 small, 0.5 medium, 0.8 large.\"\"\"\n","    return 2 * (math.asin(math.sqrt(min(max(p1, 0.0), 1.0))) -\n","                math.asin(math.sqrt(min(max(p2, 0.0), 1.0))))\n","\n","\n","def mcnemar_exact(a: pd.Series, b: pd.Series) -> dict:\n","    \"\"\"Exact McNemar: two-sided binomial on the discordant cells.\n","\n","    b = A correct & B wrong, c = A wrong & B correct.\n","    Returned with the manuscript's (b, c) convention so the numbers can be\n","    copied into the paper without reordering.\n","    \"\"\"\n","    j = a.rename(\"a\").to_frame().join(b.rename(\"b\"), how=\"inner\")\n","    n_b = int(((j.a == 1) & (j.b == 0)).sum())\n","    n_c = int(((j.a == 0) & (j.b == 1)).sum())\n","    if n_b + n_c == 0:\n","        return {\"b\": 0, \"c\": 0, \"p\": float(\"nan\"), \"n_disc\": 0, \"or\": float(\"nan\")}\n","    return {\"b\": n_b, \"c\": n_c, \"p\": float(binomtest(n_b, n_b + n_c, 0.5).pvalue),\n","            \"n_disc\": n_b + n_c,\n","            \"or\": (float(\"inf\") if n_c == 0 else n_b / n_c)}\n","\n","\n","def holm_bonferroni(pv: list) -> list:\n","    \"\"\"Holm-Bonferroni step-down. Uniformly more powerful than Bonferroni.\"\"\"\n","    n = len(pv)\n","    idx = sorted(range(n), key=lambda i: pv[i])\n","    out, prev = [None] * n, 0.0\n","    for rank, i in enumerate(idx):\n","        adj = max(min(pv[i] * (n - rank), 1.0), prev)   # enforce monotonicity\n","        out[i] = adj\n","        prev = adj\n","    return out\n","\n","\n","def benjamini_hochberg(pv: list) -> list:\n","    \"\"\"Benjamini-Hochberg FDR, computed in reverse rank order with a running min.\"\"\"\n","    n = len(pv)\n","    idx = sorted(range(n), key=lambda i: pv[i])\n","    out, cum = [None] * n, 1.0\n","    for rank in range(n - 1, -1, -1):\n","        i = idx[rank]\n","        cum = min(cum, pv[i] * n / (rank + 1))\n","        out[i] = min(cum, 1.0)\n","    return out\n","\n","\n","def _arm(k: int, n: int) -> dict:\n","    lo, hi = wilson_ci(k, n)\n","    return {\"k\": k, \"n\": n, \"acc\": 100 * k / n, \"lo\": lo, \"hi\": hi}\n","\n","\n","def _acc(df: pd.DataFrame) -> dict:\n","    return _arm(int(df[\"correct\"].sum()), len(df))\n","\n","\n","# ════════════════════════════════════════════════════════════════════════════\n","# 22.2  Overall accuracy by strategy  ->  tab:strategy_accuracy\n","# ════════════════════════════════════════════════════════════════════════════\n","print(\"\\n\" + \"─\" * 74)\n","print(\"22.2  Strategy-level accuracy (tab:strategy_accuracy)\")\n","print(\"─\" * 74)\n","\n","strategy_table = {\"ten\": {}, \"broad\": {}}\n","if FEW_OK:\n","    strategy_table[\"ten\"][\"few_shot\"] = _acc(few[few.model.isin(TEN)])\n","for _key, _strat in ((\"naive\", \"naive_rag\"), (\"rule\", \"enhanced_rag\")):\n","    strategy_table[\"ten\"][_key] = _acc(\n","        rag[(rag.strategy == _strat) & rag.model.isin(TEN)])\n","    strategy_table[\"broad\"][_key] = _acc(rag[rag.strategy == _strat])\n","\n","_ROWNAME = {\"few_shot\": \"Few-shot (corrected)\", \"naive\": r'Na\\\"ive RAG',\n","            \"rule\": \"Enhanced RAG\"}\n","_ERRNAME = {\"semantic\": \"Semantic mismatch\", \"timeout\": \"Timeout\",\n","            \"schema\": \"Schema\", \"syntax\": \"Syntax\", \"runtime\": \"Runtime\"}\n","for _blk in (\"ten\", \"broad\"):\n","    for _k, _v in strategy_table[_blk].items():\n","        print(f\"  [{_blk:5s}] {_ROWNAME[_k]:22s} {_v['k']:5d} / {_v['n']:5d}\"\n","              f\"  {_v['acc']:5.1f}  [{_v['lo']:.1f}, {_v['hi']:.1f}]\")\n","\n","# ════════════════════════════════════════════════════════════════════════════\n","# 22.3  Paired inference on the ten-model panel  ->  McNemar / Holm / BH\n","# ════════════════════════════════════════════════════════════════════════════\n","# The family is the three pairwise strategy comparisons. Holm-Bonferroni and\n","# Benjamini-Hochberg are both reported over exactly this family, which is what\n","# the manuscript states (\"across the three-test family\").\n","print(\"\\n\" + \"─\" * 74)\n","print(\"22.3  Paired McNemar + multiple-comparison correction (ten-model panel)\")\n","print(\"─\" * 74)\n","\n","mcnemar_family, corrections = {}, {}\n","if FEW_OK:\n","    def _pairs(strat):\n","        d = rag[(rag.strategy == strat) & rag.model.isin(TEN)]\n","        return d.set_index([\"q_id\", \"model\"])[\"correct\"]\n","\n","    _en, _nv = _pairs(\"enhanced_rag\"), _pairs(\"naive_rag\")\n","    _fw = few.set_index([\"q_id\", \"model\"])[\"correct\"]\n","    FAMILY = [(\"rule_vs_few\", _en, _fw),\n","              (\"rule_vs_naive\", _en, _nv),\n","              (\"naive_vs_few\", _nv, _fw)]\n","    for _name, _a, _b in FAMILY:\n","        _m = mcnemar_exact(_a, _b)\n","        _m[\"cohens_h\"] = cohens_h(float(_a.mean()), float(_b.mean()))\n","        _m[\"acc_a\"] = 100 * float(_a.mean())\n","        _m[\"acc_b\"] = 100 * float(_b.mean())\n","        mcnemar_family[_name] = _m\n","\n","    _ps = [mcnemar_family[n][\"p\"] for n, _a, _b in FAMILY]\n","    _names = [n for n, _a, _b in FAMILY]\n","    for _n, _h, _bh in zip(_names, holm_bonferroni(_ps), benjamini_hochberg(_ps)):\n","        mcnemar_family[_n][\"p_holm\"] = _h\n","        mcnemar_family[_n][\"p_bh\"] = _bh\n","    corrections = {\"family\": _names, \"p_raw\": _ps,\n","                   \"p_holm\": holm_bonferroni(_ps), \"p_bh\": benjamini_hochberg(_ps)}\n","\n","    print(f\"  {'contrast':14s} {'b':>4s} {'c':>4s} {'p':>10s} {'Cohen h':>8s}\"\n","          f\" {'p_holm':>9s} {'p_BH':>9s}\")\n","    for _n in _names:\n","        _v = mcnemar_family[_n]\n","        print(f\"  {_n:14s} {_v['b']:4d} {_v['c']:4d} {_v['p']:10.6f}\"\n","              f\" {_v['cohens_h']:8.4f} {_v['p_holm']:9.6f} {_v['p_bh']:9.6f}\")\n","    print(f\"\\n  all three significant at alpha=0.05 after Holm: \"\n","          f\"{all(v['p_holm'] < 0.05 for v in mcnemar_family.values())}\")\n","    print(f\"  all three significant at alpha=0.05 after BH  : \"\n","          f\"{all(v['p_bh'] < 0.05 for v in mcnemar_family.values())}\")\n","else:\n","    print(\"  [skipped] paired inference needs the ten-model panel, which is defined\")\n","    print(\"            by few_shot_rerun_kbench_results.csv. It is not attached, so\")\n","    print(\"            NO substitution is made — a wrong panel silently changes every\")\n","    print(\"            b, c and p. Attach wganme/urban-observatory-results.\")\n","\n","# ════════════════════════════════════════════════════════════════════════════\n","# 22.4  Tier-stratified accuracy and per-tier Fisher tests ->  tab:tier_accuracy\n","# ════════════════════════════════════════════════════════════════════════════\n","# NOTE ON METHOD CHOICE, stated explicitly because it looks like an omission:\n","# Fisher's exact test treats the 300 observations in a tier cell as INDEPENDENT.\n","# They are not — 30 questions are each answered by 10 models, so the effective\n","# n is ~30 and Fisher is anti-conservative (it finds significance LESS often\n","# than the paired test, which is why the T5 result below is not significant even\n","# though the paired contrast is). The manuscript reports Fisher for per-tier\n","# comparisons for consistency with the companion study, and reports McNemar as\n","# the primary basis for significance claims. Both are computed here.\n","print(\"\\n\" + \"─\" * 74)\n","print(\"22.4  Tier-stratified accuracy + per-tier Fisher exact (tab:tier_accuracy)\")\n","print(\"─\" * 74)\n","\n","tier_cells, tier_tests = {}, {}\n","for _t in TIERS:\n","    _c = {}\n","    if FEW_OK:\n","        _c[\"few\"] = _acc(few[few.tier == _t])\n","    _c[\"naive\"] = _acc(rag[(rag.tier == _t) & (rag.strategy == \"naive_rag\")\n","                           & rag.model.isin(TEN)])\n","    _c[\"rule\"] = _acc(rag[(rag.tier == _t) & (rag.strategy == \"enhanced_rag\")\n","                          & rag.model.isin(TEN)])\n","    tier_cells[_t] = _c\n","\n","    _tests = {}\n","    _kr, _nr = _c[\"rule\"][\"k\"], _c[\"rule\"][\"n\"]\n","    _kn, _nn = _c[\"naive\"][\"k\"], _c[\"naive\"][\"n\"]\n","    _or, _p = fisher_exact([[_kr, _nr - _kr], [_kn, _nn - _kn]])\n","    _tests[\"rule_vs_naive\"] = {\"or\": float(_or), \"p\": float(_p),\n","                               \"cohens_h\": cohens_h(_kr / _nr, _kn / _nn)}\n","    if FEW_OK:\n","        _kf, _nf = _c[\"few\"][\"k\"], _c[\"few\"][\"n\"]\n","        _orf, _pf = fisher_exact([[_kr, _nr - _kr], [_kf, _nf - _kf]])\n","        _tests[\"rule_vs_few\"] = {\"or\": float(_orf), \"p\": float(_pf),\n","                                 \"cohens_h\": cohens_h(_kr / _nr, _kf / _nf)}\n","    tier_tests[_t] = _tests\n","\n","    _hdr = \"  {t}  \".format(t=_t)\n","    for _k in (\"few\", \"naive\", \"rule\"):\n","        if _k in _c:\n","            _hdr += f\"{_c[_k]['acc']:5.1f} [{_c[_k]['lo']:4.1f},{_c[_k]['hi']:4.1f}]  \"\n","    _hdr += (f\"  H(rule/naive)={_tests['rule_vs_naive']['cohens_h']:+.3f}\"\n","             f\"  Fisher p={_tests['rule_vs_naive']['p']:.4f}\")\n","    print(_hdr)\n","    if \"rule_vs_few\" in _tests:\n","        print(f\"        p(rule/few)={_tests['rule_vs_few']['p']:.4f}  \"\n","              f\"H={_tests['rule_vs_few']['cohens_h']:+.3f}\")\n","    else:\n","        print(\"        (few-shot file absent — rule/few per-tier test skipped)\")\n","\n","# ── Holm/BH across the 10 per-tier Fisher comparisons, for completeness ─────\n","_tier_p = [tier_tests[t][c][\"p\"] for t in TIERS for c in (\"rule_vs_naive\", \"rule_vs_few\")\n","           if c in tier_tests[t]]\n","if len(_tier_p) > 1:\n","    print(f\"\\n  per-tier Fisher family (n={len(_tier_p)}): \"\n","          f\"min p={min(_tier_p):.4f} -> after Holm {min(holm_bonferroni(_tier_p)):.4f},\"\n","          f\" after BH {min(benjamini_hochberg(_tier_p)):.4f}\")\n","    print(\"  (no per-tier comparison survives correction — the paper's tier-level\")\n","    print(\"   claims are descriptive, and significance rests on the paired panel)\")\n","\n","# ════════════════════════════════════════════════════════════════════════════\n","# 22.5  Error breakdown ->  tab:error_breakdown\n","# ════════════════════════════════════════════════════════════════════════════\n","# The classification runs over INCORRECT rows only, and the discriminator is\n","# deliberately narrow: a row counts as \"semantic\" when the query RAN and\n","# returned the wrong rows, which is the silent failure mode this paper is about.\n","#   empty error_msg            -> semantic   (ran, wrong result set)\n","#   contains \"timeout\"         -> timeout\n","#   \"no such column/table\", \"ambiguous column\"  -> schema\n","#   \"syntax error\"             -> syntax\n","#   anything else              -> runtime\n","# This reproduces the manuscript's table exactly for all three arms.\n","print(\"\\n\" + \"─\" * 74)\n","print(\"22.5  Error breakdown (tab:error_breakdown)\")\n","print(\"─\" * 74)\n","\n","ERR_CATS = [\"semantic\", \"timeout\", \"schema\", \"syntax\", \"runtime\"]\n","\n","\n","def classify_error(msg) -> str:\n","    s = str(msg).strip().lower()\n","    if s in (\"\", \"nan\"):\n","        return \"semantic\"\n","    if \"timeout\" in s:\n","        return \"timeout\"\n","    if \"no such column\" in s or \"no such table\" in s or \"ambiguous column\" in s:\n","        return \"schema\"\n","    if \"syntax error\" in s:\n","        return \"syntax\"\n","    return \"runtime\"\n","\n","\n","error_breakdown = {}\n","_err_arms = [(\"few_shot\", allf if ALLF_OK else None),\n","             (\"naive_rag\", rag[rag.strategy == \"naive_rag\"]),\n","             (\"enhanced_rag\", rag[rag.strategy == \"enhanced_rag\"])]\n","for _name, _d in _err_arms:\n","    if _d is None:\n","        error_breakdown[_name] = None\n","        print(f\"  {_name:13s} [skipped] needs all_experiment_results.csv (29-model archive)\")\n","        continue\n","    _inc = _d[_d[\"correct\"] == 0]\n","    _vc = _inc[\"error_msg\"].fillna(\"\").map(classify_error).value_counts().to_dict()\n","    error_breakdown[_name] = {**_vc, \"total\": int(len(_inc))}\n","    print(f\"  {_name:13s} \" + \"  \".join(\n","        f\"{c}={error_breakdown[_name].get(c, 0):4d}\" for c in ERR_CATS) +\n","        f\"   total={error_breakdown[_name]['total']:5d}\")\n","\n","# ════════════════════════════════════════════════════════════════════════════\n","# 22.6  Published vs corrected tier accuracies ->  tab:tier_correction\n","# ════════════════════════════════════════════════════════════════════════════\n","# PROVENANCE: this compares the companion study's PUBLISHED tier accuracies\n","# against the CORRECTED re-scoring of the same 4,246 few-shot queries. It is\n","# paper-1-lineage material reproduced for completeness, not paper 2 evidence.\n","print(\"\\n\" + \"─\" * 74)\n","print(\"22.6  Published vs corrected tier accuracies (tab:tier_correction)\")\n","print(\"─\" * 74)\n","\n","# IEEE Access (companion study) published tier accuracies — fixed constants,\n","# quoted from the published record rather than recomputed (the published\n","# scoring cannot be re-derived from the corrected CSV).\n","PUBLISHED_TIER = {\"T1\": 76.8, \"T2\": 56.7, \"T3\": 41.1, \"T4\": 41.5, \"T5\": 26.7}\n","tier_correction = {}\n","if ALLF_OK:\n","    for _t in TIERS:\n","        _d = allf[allf[\"tier\"] == _t]\n","        tier_correction[_t] = {\"published\": PUBLISHED_TIER[_t],\n","                               \"corrected\": 100 * int(_d[\"correct\"].sum()) / len(_d)}\n","        print(f\"  {_t}  published {PUBLISHED_TIER[_t]:5.1f}%   \"\n","              f\"corrected {tier_correction[_t]['corrected']:5.1f}%\")\n","else:\n","    print(\"  [skipped] needs all_experiment_results.csv\")\n","\n","# ════════════════════════════════════════════════════════════════════════════\n","# 22.7  Figure — enhanced-RAG accuracy vs per-query SEI  ->  fig:accuracy_sei\n","# ════════════════════════════════════════════════════════════════════════════\n","# One point per question (jittered: SEI is discrete), coloured by tier, with\n","# pooled binned means and 95% Wilson intervals. The decline in accuracy is\n","# CONFOUNDED with tier difficulty — higher tiers retrieve more schema AND are\n","# harder — and the figure says so rather than implying a causal reading.\n","print(\"\\n\" + \"─\" * 74)\n","print(\"22.7  Accuracy vs SEI (fig:accuracy_sei)\")\n","print(\"─\" * 74)\n","\n","sei_bins, sei_rho = [], {}\n","_pooled_bins = []           # populated in 22.7; always defined for the sidecar\n","if N4.get(\"per_question_rho\", {}).get(\"enhanced\"):\n","    _env = rag[rag.strategy == \"enhanced_rag\"]\n","    for _q, _s in N4[\"per_question_rho\"][\"enhanced\"].items():\n","        _d = _env[_env[\"q_id\"] == _q]\n","        if not len(_d):\n","            continue\n","        sei_rho[_q] = float(_s)\n","        sei_bins.append({\"q_id\": _q, \"tier\": str(_q).split(\"_\")[0], \"sei\": float(_s),\n","                         \"k\": int(_d[\"correct\"].sum()), \"n\": len(_d),\n","                         \"acc\": 100 * int(_d[\"correct\"].sum()) / len(_d)})\n","    _sd = pd.DataFrame(sei_bins)\n","    _g = (_sd.groupby(\"sei\").agg(k=(\"k\", \"sum\"), n=(\"n\", \"sum\"), nq=(\"q_id\", \"count\"))\n","          .reset_index())\n","    _g[\"acc\"] = 100 * _g.k / _g.n\n","    _g[[\"lo\", \"hi\"]] = [wilson_ci(int(r.k), int(r.n)) for r in _g.itertuples()]\n","    print(\"  pooled bins:\")\n","    for _r in _g.itertuples():\n","        print(f\"    SEI={_r.sei:.4f}  questions={_r.nq:3d}  acc={_r.acc:5.1f}%\"\n","              f\"  [{_r.lo:.1f}, {_r.hi:.1f}]\")\n","    _pooled_bins = [{\"sei\": float(r.sei), \"n_questions\": int(r.nq),\n","                     \"k\": int(r.k), \"n\": int(r.n), \"acc\": float(r.acc),\n","                     \"ci\": [float(r.lo), float(r.hi)]} for r in _g.itertuples()]\n","    print(f\"  per-question scatter: n={len(_sd)}  mean accuracy \"\n","          f\"{_sd.acc.mean():.1f}%\")\n","\n","    if _MPL_OK:\n","        _C_TIER = {\"T1\": \"#4c72b0\", \"T2\": \"#55a868\", \"T3\": \"#c44e52\",\n","                   \"T4\": \"#8172b2\", \"T5\": \"#937860\"}\n","        _fig, _ax = plt.subplots(figsize=(5.0, 3.2))\n","        _rng = np.random.default_rng(0)\n","        for _t in TIERS:\n","            _sub = _sd[_sd.tier == _t]\n","            if not len(_sub):\n","                continue\n","            _jit = _rng.uniform(-0.012, 0.012, len(_sub))\n","            _ax.scatter(_sub.sei + _jit, _sub.acc, s=9, alpha=0.55,\n","                        color=_C_TIER.get(_t, \"#888888\"), edgecolors=\"none\",\n","                        label=f\"{_t} (n={len(_sub)})\", zorder=3)\n","        _ax.errorbar(_g.sei, _g.acc, yerr=[_g.acc - _g.lo, _g.hi - _g.acc],\n","                     fmt=\"o-\", ms=5.5, lw=1.6, capsize=3, color=\"#111111\",\n","                     markerfacecolor=\"white\", markeredgewidth=1.2,\n","                     label=\"pooled bin mean (95% Wilson)\", zorder=5)\n","        for _r in _g.itertuples():\n","            _ax.text(_r.sei, min(_r.hi + 4.5, 104), f\"{_r.acc:.1f}\",\n","                     ha=\"center\", fontsize=6.4, color=\"#111111\", zorder=6)\n","        _ax.set_xlabel(\"Relative Schema Exposure Index (SEI) per query\")\n","        _ax.set_ylabel(\"Enhanced-RAG execution accuracy (%)\")\n","        _ax.set_ylim(-4, 108)\n","        _ax.set_xlim(0.92, 1.60)\n","        _ax.set_title(\"Accuracy vs SEI — one point per question\", fontsize=9.5)\n","        _ax.grid(lw=0.35, alpha=0.3, zorder=0)\n","        _ax.set_axisbelow(True)\n","        _ax.legend(frameon=False, fontsize=6.2, loc=\"upper right\",\n","                   ncol=2, handletextpad=0.4, columnspacing=0.8)\n","        _ax.text(0.985, -0.30,\n","                 \"Decline is CONFOUNDED with tier difficulty: higher tiers \"\n","                 \"retrieve more schema and are harder.\",\n","                 transform=_ax.transAxes, ha=\"right\", fontsize=6.0, color=\"#777777\")\n","        _fig.tight_layout()\n","        _fig.savefig(_FIG / \"fig_accuracy_sei.pdf\")\n","        _fig.savefig(_FIG / \"fig_accuracy_sei.png\")\n","        plt.close(_fig)\n","        print(f\"\\n  -> {_FIG / 'fig_accuracy_sei.pdf'}\")\n","else:\n","    print(\"  [skipped] n4_rho_analysis.json with per_question_rho is not attached.\")\n","\n","# ════════════════════════════════════════════════════════════════════════════\n","# 22.8  Zero-shot control (Experiment B)  ->  tab:zero_shot_coverage\n","# ════════════════════════════════════════════════════════════════════════════\n","# The manuscript's Zero-Shot Control section reports a full-DDL, no-examples\n","# condition on the same ten-model panel: 416/1,200 = 34.7% after excluding two\n","# models whose endpoint returned a literal \"ERROR\" string on every question.\n","# That exclusion, the per-tier execution coverage (paper Table VIII) and the\n","# three McNemar contrasts are all computed here — nothing about this condition\n","# is reproducible without this block.\n","print(\"\\n\" + \"─\" * 74)\n","print(\"22.8  Zero-shot control — Experiment B (tab:zero_shot_coverage)\")\n","print(\"─\" * 74)\n","\n","zero_shot, zs_contrasts = {}, {}\n","if ZB is None:\n","    print(\"  [skipped] experiment_b_kbench_results.csv is not attached.\")\n","else:\n","    ZB[\"model\"] = ZB[\"model\"].astype(str).str.replace(r\"@default$\", \"\", regex=True)\n","    # A record counts as UNEXECUTED when the endpoint returned no SQL at all:\n","    # either a literal provider-error string or an empty generation. This is the\n","    # distinction the paper draws when it excludes the two dead endpoints.\n","    ZB[\"_unexecuted\"] = ZB[\"generated_sql\"].map(\n","        lambda g: str(g).startswith(\"ERROR\") or str(g).strip() in (\"\", \"nan\"))\n","    _dead = sorted(m for m, g in ZB.groupby(\"model\") if g[\"_unexecuted\"].all())\n","    _keep = ZB[~ZB[\"model\"].isin(_dead)]\n","    _k, _n = int(_keep[\"correct\"].sum()), len(_keep)\n","    _lo, _hi = wilson_ci(_k, _n)\n","    zero_shot = {\"models_excluded\": _dead, \"n_models\": ZB[\"model\"].nunique() - len(_dead),\n","                 \"n\": _n, \"k\": _k, \"acc\": 100 * _k / _n, \"ci\": [_lo, _hi],\n","                 \"per_tier\": {}}\n","    for _t in TIERS:\n","        _g = ZB[ZB[\"tier\"] == _t]\n","        zero_shot[\"per_tier\"][_t] = {\n","            \"attempted\": len(_g),\n","            \"executed\": int((~_g[\"_unexecuted\"]).sum()),\n","            \"correct\": int(_g[~_g[\"_unexecuted\"]][\"correct\"].sum())}\n","\n","    print(f\"  excluded (every question an ERROR string): {len(_dead)} models\")\n","    for _m in _dead:\n","        print(f\"      {_m}\")\n","    print(f\"  zero-shot full-schema: {_k:,} / {_n:,} = {100*_k/_n:.1f}%\"\n","          f\"  [{_lo:.1f}, {_hi:.1f}]   (8 models x 150)\")\n","    print(f\"  {'tier':5s} {'attempted':>9s} {'executed':>9s} {'correct':>8s}\")\n","    for _t in TIERS:\n","        _v = zero_shot[\"per_tier\"][_t]\n","        print(f\"  {_t:5s} {_v['attempted']:9d} {_v['executed']:9d} {_v['correct']:8d}\")\n","\n","    # The three paired contrasts the manuscript quotes.\n","    _zk = _keep.set_index([\"q_id\", \"model\"])[\"correct\"]\n","    _arms = []\n","    if FEW_OK:\n","        _arms.append((\"few_shot\", few.set_index([\"q_id\", \"model\"])[\"correct\"]))\n","    _arms += [(\"naive_rag\", rag[(rag.strategy == \"naive_rag\") & rag.model.isin(TEN)]\n","               .set_index([\"q_id\", \"model\"])[\"correct\"]),\n","              (\"enhanced_rag\", rag[(rag.strategy == \"enhanced_rag\") & rag.model.isin(TEN)]\n","               .set_index([\"q_id\", \"model\"])[\"correct\"])]\n","    print()\n","    for _lbl, _a in _arms:\n","        _nb_c, _nc_c, _p = mcnemar_exact(_a, _zk)[\"b\"], mcnemar_exact(_a, _zk)[\"c\"], \\\n","            mcnemar_exact(_a, _zk)[\"p\"]\n","        _h = cohens_h(float(_a.mean()), float(_zk.mean()))\n","        zs_contrasts[_lbl] = {\"b\": _nb_c, \"c\": _nc_c, \"p\": _p,\n","                              \"cohens_h\": _h,\n","                              \"acc_other\": 100 * float(_a.mean())}\n","        print(f\"  McNemar {_lbl:13s} vs zero-shot: b={_nb_c:3d} c={_nc_c:3d}\"\n","              f\"  p={_p:.3g}  h={_h:+.3f}  ({100*float(_a.mean()):.1f}% vs\"\n","              f\" {100*_zk.mean():.1f}%)\")\n","    if FEW_OK:\n","        print(f\"\\n  few-shot minus zero-shot = \"\n","              f\"{100*float(few['correct'].mean()) - zero_shot['acc']:.1f} pp \"\n","              f\"(the manuscript's ~13 pp)\")\n","    zero_shot[\"contrasts\"] = zs_contrasts\n","\n","# ════════════════════════════════════════════════════════════════════════════\n","# 22.9  Schema and method tables  ->  tab:snapshot, tab:tables_referenced,\n","#                                     tab:strategy_composition, tab:panel_ids\n","# ════════════════════════════════════════════════════════════════════════════\n","# Four tables in the manuscript are METHOD descriptions rather than results.\n","# They are still emitted from code so the manuscript's tables and the benchmark\n","# definition cannot drift apart.\n","print(\"\\n\" + \"─\" * 74)\n","print(\"22.9  Schema and method tables\")\n","print(\"─\" * 74)\n","\n","# ── tab:snapshot — frozen snapshot sizes and the columns the prompt declares ──\n","snapshot_tbl = {}\n","for _t in (\"sensors\", \"variables\", \"readings\"):\n","    _body = re.search(rf\"CREATE TABLE {_t}\\s*\\((.*?)\\);\", SCHEMA_DDL if \"SCHEMA_DDL\" in globals()\n","                      else \"\", re.S)\n","    _cols = []\n","    if _body:\n","        for _ln in _body.group(1).replace(\"\\n\", \" \").split(\",\"):\n","            _m = re.match(r\"\\s*(\\w+)\", _ln)\n","            if _m and _m.group(1).upper() not in (\"PRIMARY\", \"FOREIGN\", \"NOT\", \"TEXT\"):\n","                _cols.append(_m.group(1))\n","    _rows = {\"sensors\": 1411, \"variables\": 112, \"readings\": 87962}.get(_t, 0)\n","    # Prefer the counts actually read off the frozen DB when it is attached\n","    # (Section 8 sets DB_PATH); otherwise fall back to the published constants.\n","    _dbp = globals().get(\"DB_PATH\")\n","    if _dbp is not None:\n","        try:\n","            _c = sqlite3.connect(f\"file:{_dbp}?mode=ro\", uri=True)\n","            _rows = int(_c.execute(f\"SELECT COUNT(*) FROM {_t}\").fetchone()[0])\n","            _c.close()\n","        except Exception:\n","            pass\n","    snapshot_tbl[_t] = {\"rows\": _rows, \"cols\": _cols}\n","_COLS_FALLBACK = {\n","    \"sensors\": [\"sensor_name\", \"location_wkt\", \"centroid_lon\", \"centroid_lat\",\n","                \"ground_height\", \"sensor_height\", \"broker_name\", \"raw_id\"],\n","    \"variables\": [\"variable_name\", \"units\", \"theme\"],\n","    \"readings\": [\"id\", \"sensor_name\", \"variable\", \"value\", \"timestamp\", \"flagged\"]}\n","for _t, _v in snapshot_tbl.items():\n","    if not _v[\"cols\"]:\n","        _v[\"cols\"] = _COLS_FALLBACK[_t]\n","    print(f\"  {_t:10s} rows={_v['rows']:>7,}  cols={len(_v['cols'])}\"\n","          f\"  ({', '.join(_v['cols'][:3])}, ...)\")\n","\n","# ── tab:tables_referenced — tables the gold queries touch, by tier ────────────\n","tables_referenced = {}\n","if QUESTIONS:\n","    for _t in TIERS:\n","        _c = collections.Counter()\n","        for _q in QUESTIONS:\n","            if _q.get(\"tier\") != _t:\n","                continue\n","            _names = {_x for _x in (\"sensors\", \"variables\", \"readings\")\n","                      if re.search(rf\"\\b{_x}\\b\", str(_q.get(\"sql\", \"\")), re.I)}\n","            _c[\"+\".join(sorted(_x[0].upper() for _x in _names))] += 1\n","        tables_referenced[_t] = {_k: _c.get(_k, 0)\n","                                 for _k in (\"S\", \"V\", \"R\", \"R+S\", \"R+V\", \"R+S+V\")}\n","    print(\"\\n  tables referenced by gold queries (rows sum to 30 per tier):\")\n","    for _t in TIERS:\n","        _v = tables_referenced[_t]\n","        print(f\"    {_t} \" + \"  \".join(f\"{_k}={_v[_k]:2d}\" for _k in _v)\n","              + f\"   total={sum(_v.values())}\")\n","else:\n","    print(\"\\n  [skipped] benchmark_questions.json is not attached.\")\n","\n","# ── tab:strategy_composition — static description of the three arms ──────────\n","strategy_composition = [\n","    {\"strategy\": \"Full-schema few-shot\", \"schema_text\": \"DDL + descriptions\",\n","     \"tables\": \"3 (all)\", \"selection\": \"none\", \"rules\": \"none\",\n","     \"worked_examples\": \"3\"},\n","    {\"strategy\": \"Na\\\\\\\"ive retrieval\", \"schema_text\": \"DDL + descriptions\",\n","     \"tables\": \"2\", \"selection\": \"top-2 cosine\", \"rules\": \"none\",\n","     \"worked_examples\": \"none\"},\n","    {\"strategy\": \"Rule-augmented retrieval\", \"schema_text\": \"DDL + descriptions\",\n","     \"tables\": \"2 or 3 (3 for 75 questions)\", \"selection\": \"top-2 + two rules\",\n","     \"rules\": \"theme detection, relationship expansion\", \"worked_examples\": \"none\"},\n","]\n","deliv_total = None\n","if \"deliv\" in globals() and isinstance(globals().get(\"deliv\"), dict):\n","    deliv_total = sum(v.get(\"three\", 0) for v in globa